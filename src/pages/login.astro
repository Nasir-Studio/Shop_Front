---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
---

<BaseLayout title="登入 — 小羊農場">
  <Header />

  <main class="pt-header">
    <div class="container">
      <div class="auth-page">
        <div class="auth-card">
          <h1>登入</h1>
          <p class="auth-subtitle">歡迎回來</p>

          <form class="auth-form" id="login-form" onsubmit="return false">
            <div class="form-group">
              <label class="form-label">電子郵件</label>
              <input type="email" class="form-input" name="email" required placeholder="your@email.com" autocomplete="email" />
            </div>
            <div class="form-group">
              <label class="form-label">密碼</label>
              <input type="password" class="form-input" name="password" required placeholder="請輸入密碼" autocomplete="current-password" />
            </div>

            <div id="login-error" class="error-msg" style="display:none"></div>

            <button type="submit" class="btn btn-primary btn-block btn-lg" id="login-submit">
              登入
            </button>
          </form>

          <p class="auth-switch">
            還沒有帳號？ <a href="/register">立即註冊</a>
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  var API_URL = window.location.hostname === 'shop.nsir.uk' ? 'https://shopbackend.nsir.uk' : 'http://localhost:8000';
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('login-form');
    const errorEl = document.getElementById('login-error');

    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(form);
        const email = formData.get('email');
        const password = formData.get('password');
        const submitBtn = document.getElementById('login-submit');

        submitBtn.disabled = true;
        submitBtn.textContent = '登入中...';
        errorEl.style.display = 'none';

        try {
          const res = await fetch(`${API_URL}/api/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });

          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.detail || '登入失敗');
          }

          const data = await res.json();
          localStorage.setItem('shop_token', data.access_token);
          localStorage.setItem('shop_user', JSON.stringify(data.user));
          window.location.href = '/';
        } catch (err) {
          var msg = (err instanceof TypeError) ? '目前網路出現狀況中，請稍後再試' : (err.message || '登入失敗');
          errorEl.textContent = msg;
          errorEl.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = '登入';
        }
      });
    }
  });
</script>

<style>
  .auth-page {
    display: flex;
    justify-content: center;
    padding: var(--sp-16) 0;
  }

  .auth-card {
    width: 100%;
    max-width: 400px;
  }

  .auth-card h1 {
    font-size: var(--text-2xl);
    font-weight: 400;
    text-align: center;
    margin-bottom: var(--sp-2);
  }

  .auth-subtitle {
    text-align: center;
    color: var(--c-text-secondary);
    font-size: var(--text-sm);
    margin-bottom: var(--sp-8);
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .error-msg {
    padding: var(--sp-3) var(--sp-4);
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: var(--c-error);
    font-size: var(--text-sm);
    border-radius: var(--radius);
  }

  .auth-switch {
    text-align: center;
    margin-top: var(--sp-6);
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }

  .auth-switch a {
    color: var(--c-text);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
