---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdminGuard from '../../components/AdminGuard.astro';
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
---

<BaseLayout title="訂單管理 — 小羊農場">
  <AdminGuard />
  <Header />

  <main class="pt-header">
    <div class="container">
      <div class="page-header">
        <h1>管理後台</h1>
      </div>

      <nav class="admin-nav">
        <a href="/admin" class="admin-nav-link">統計總覽</a>
        <a href="/admin/products" class="admin-nav-link">商品管理</a>
        <a href="/admin/orders" class="admin-nav-link active">訂單管理</a>
        <a href="/admin/users" class="admin-nav-link">會員管理</a>
        <a href="/admin/messages" class="admin-nav-link">訊息管理</a>
      </nav>

      <div class="table-wrap">
        <table id="orders-table">
          <thead>
            <tr>
              <th>訂單 #</th>
              <th>用戶</th>
              <th>商品數</th>
              <th>金額</th>
              <th>狀態</th>
              <th>日期</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody id="orders-tbody">
            <tr><td colspan="7" class="text-center text-secondary" style="padding:var(--sp-8)">載入中...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  var API_URL = window.location.hostname === 'shop.nsir.uk' ? 'https://shopbackend.nsir.uk' : 'http://localhost:8000';
  const statusMap = { pending: '訂單未付款', paid: '訂單已成立', shipped: '訂單待出貨', completed: '訂單已完成', cancelled: '已取消' };
  const statusList = ['pending', 'paid', 'shipped', 'completed', 'cancelled'];

  document.addEventListener('DOMContentLoaded', async function() {
    if (!window.__requireAdmin()) return;
    const token = localStorage.getItem('shop_token');

    async function api(path, opts) {
      opts = opts || {};
      opts.headers = Object.assign({ 'Authorization': 'Bearer ' + token }, opts.headers || {});
      if (opts.body && typeof opts.body === 'object') {
        opts.headers['Content-Type'] = 'application/json';
        opts.body = JSON.stringify(opts.body);
      }
      const res = await fetch(API_URL + path, opts);
      if (!res.ok) { const err = await res.json().catch(() => ({detail: '請求失敗'})); throw new Error(err.detail || '請求失敗'); }
      return res.json();
    }

    async function loadOrders() {
      try {
        const orders = await api('/api/admin/orders');
        const tbody = document.getElementById('orders-tbody');
        if (!orders.length) {
          tbody.innerHTML = '<tr><td colspan="7" class="text-center text-secondary" style="padding:var(--sp-8)">尚無訂單</td></tr>';
          return;
        }
        tbody.innerHTML = orders.map(function(o) {
          const date = new Date(o.created_at).toLocaleDateString('zh-TW');
          return '<tr>' +
            '<td>#' + o.id + '</td>' +
            '<td>' + o.user_email + '</td>' +
            '<td>' + o.item_count + '</td>' +
            '<td>NT$' + o.total.toLocaleString() + '</td>' +
            '<td><span class="status status-' + o.status + '"><span class="status-dot"></span>' + statusMap[o.status] + '</span></td>' +
            '<td>' + date + '</td>' +
            '<td><button class="btn btn-ghost btn-sm" onclick="toggleDetail(' + o.id + ')">明細</button></td>' +
            '</tr>' +
            '<tr class="order-detail" id="detail-' + o.id + '" style="display:none">' +
            '<td colspan="7">' +
            '<div class="detail-body">' +
              '<div class="detail-grid">' +
                '<div class="detail-section">' +
                  '<strong>收件資訊</strong>' +
                  '<p>' + escHtml(o.shipping_name) + ' / ' + escHtml(o.shipping_phone || '') + '</p>' +
                  (o.shipping_address ? '<p>' + escHtml(o.shipping_address) + '</p>' : '') +
                  (o.shipping_method === 'store_pickup' ? '<p>超取：' + escHtml(o.store_name || '') + ' (' + escHtml(o.store_code || '') + ')</p>' : '') +
                  '<p>付款方式：' + paymentLabel(o.payment_method) + '</p>' +
                  '<p>運費：NT$' + (o.shipping_fee || 0).toLocaleString() + '</p>' +
                '</div>' +
                '<div class="detail-section">' +
                  '<strong>客戶備註</strong>' +
                  '<p class="detail-note">' + escHtml(o.note || '無') + '</p>' +
                '</div>' +
                '<div class="detail-section">' +
                  '<strong>管理員備註</strong>' +
                  '<textarea class="input admin-note-input" id="admin-note-' + o.id + '" rows="2">' + escHtml(o.admin_note || '') + '</textarea>' +
                  '<button class="btn btn-ghost btn-sm" onclick="saveNote(' + o.id + ')">儲存備註</button>' +
                '</div>' +
                '<div class="detail-section">' +
                  '<strong>訂單狀態</strong>' +
                  '<select class="input status-select" onchange="updateStatus(' + o.id + ', this.value)">' +
                    statusList.map(function(s) {
                      return '<option value="' + s + '"' + (s === o.status ? ' selected' : '') + '>' + statusMap[s] + '</option>';
                    }).join('') +
                  '</select>' +
                '</div>' +
              '</div>' +
            '</div>' +
            '</td></tr>';
        }).join('');
      } catch (err) {
        console.error(err);
        document.getElementById('orders-tbody').innerHTML = '<tr><td colspan="7" class="text-center text-secondary" style="padding:var(--sp-8)">載入失敗</td></tr>';
      }
    }

    function escHtml(s) {
      if (!s) return '';
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function paymentLabel(m) {
      var labels = { cash: '貨到付款', bank_transfer: '銀行轉帳', line_pay: 'Line Pay', crypto: '加密貨幣', paypal: 'PayPal' };
      return labels[m] || m;
    }

    window.toggleDetail = function(id) {
      var el = document.getElementById('detail-' + id);
      if (el) el.style.display = el.style.display === 'none' ? 'table-row' : 'none';
    };

    window.updateStatus = async function(id, newStatus) {
      try {
        await api('/api/admin/orders/' + id + '/status', { method: 'PUT', body: { status: newStatus } });
        loadOrders();
      } catch (err) {
        alert('更新狀態失敗：' + err.message);
        loadOrders(); // reload to reset dropdown
      }
    };

    window.saveNote = async function(id) {
      var textarea = document.getElementById('admin-note-' + id);
      if (!textarea) return;
      var note = textarea.value;
      try {
        await api('/api/admin/orders/' + id + '/note', { method: 'PUT', body: { admin_note: note } });
        textarea.value = note;
        alert('備註已儲存');
      } catch (err) {
        alert('儲存失敗：' + err.message);
      }
    };

    loadOrders();
  });
</script>

<style>
  .page-header {
    padding: var(--sp-10) 0;
    border-bottom: 1px solid var(--c-border);
    margin-bottom: var(--sp-6);
  }

  .page-header h1 {
    font-size: var(--text-3xl);
    font-weight: 400;
  }

  .admin-nav {
    display: flex;
    gap: var(--sp-6);
    border-bottom: 1px solid var(--c-border);
    margin-bottom: var(--sp-6);
  }

  .admin-nav-link {
    padding: var(--sp-3) 0;
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
    border-bottom: 2px solid transparent;
    transition: all var(--duration) var(--ease);
  }

  .admin-nav-link:hover { color: var(--c-text); }
  .admin-nav-link.active {
    color: var(--c-text);
    border-bottom-color: var(--c-text);
    font-weight: 500;
  }

  .text-center { text-align: center; }

  .order-detail { background: var(--c-bg-light); }
  .order-detail td { padding: 0 !important; }
  .detail-body { padding: var(--sp-5) var(--sp-6); }
  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-6);
  }
  .detail-section strong {
    display: block;
    font-size: var(--text-sm);
    margin-bottom: var(--sp-2);
    color: var(--c-text-secondary);
  }
  .detail-section p {
    font-size: var(--text-sm);
    margin: var(--sp-1) 0;
  }
  .detail-note {
    background: #fff;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius);
    border: 1px solid var(--c-border);
    min-height: 2.5em;
  }
  .admin-note-input { width: 100%; margin-bottom: var(--sp-2); }
  .status-select { width: 100%; }

  @media (max-width: 768px) {
    .detail-grid { grid-template-columns: 1fr; }
  }
</style>
