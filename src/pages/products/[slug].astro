---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const API_URL = import.meta.env.PUBLIC_API_URL || 'https://shopbackend.nsir.uk';

export async function getStaticPaths() {
  // 建置時以正式 API 作為 fallback，CI（GitHub Pages）未設定 PUBLIC_API_URL secret 時仍能產出真實商品頁。
  const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://shopbackend.nsir.uk';
  const fallbackPaths = [{ params: { slug: '_placeholder' } }];
  try {
    // API 的 page_size 上限為 48，分頁抓取所有頁面以預建靜態頁，避免 GitHub Pages 的 404 閃現。
    const pageSize = 48;
    const paths: { params: { slug: string } }[] = [];
    let page = 1;
    let pages = 1;
    do {
      const res = await fetch(`${apiUrl}/api/products?page=${page}&page_size=${pageSize}`);
      if (!res.ok) throw new Error(`API returned ${res.status}`);
      const data = await res.json();
      const items: { slug: string }[] = data.items || [];
      items.forEach((p) => paths.push({ params: { slug: p.slug } }));
      pages = data.pages || 1;
      page += 1;
    } while (page <= pages);
    return paths.length > 0 ? paths : fallbackPaths;
  } catch (e) {
    console.warn('getStaticPaths: unable to fetch products, generating placeholder only', e);
    return fallbackPaths;
  }
}
---

<BaseLayout title="商品 — 小羊農場">
  <Header />

  <main class="pt-header">
    <div class="container" id="product-container">
      <div style="padding:var(--sp-16) 0;text-align:center;color:var(--c-text-secondary)">載入中...</div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  var API_URL = window.location.hostname === 'shop.nsir.uk' ? 'https://shopbackend.nsir.uk' : 'http://localhost:8000';
  var __cc = window.__currency;
  function _fmt(ntd) {
    if (ntd === 0) return '<span data-ntd="0">免費</span>';
    if (__cc && __cc._rates) return __cc.format(ntd);
    return '<span data-ntd="' + ntd + '">NT$' + (ntd || 0).toLocaleString() + '</span>';
  }
  window.switchMainImage = function(url, el) {
    var wrap = document.getElementById('main-image-wrap');
    if (wrap) wrap.innerHTML = '<img src="' + url + '" alt="" loading="lazy" />';
    var items = document.querySelectorAll('.thumbnail-item');
    items.forEach(function(i) { i.classList.remove('active'); });
    if (el) el.classList.add('active');
  };
  document.addEventListener('DOMContentLoaded', async function() {
    var slug = window.location.pathname.split('/').filter(Boolean).pop();
    var container = document.getElementById('product-container');

    try {
      var res = await fetch(API_URL + '/api/products/' + slug);
      if (!res.ok) throw new Error('Not found');
      var p = await res.json();
      document.title = p.name + ' — 小羊農場';

      var images = p.images || [];
      var coverIdx = -1;
      for (var idx = 0; idx < images.length; idx++) {
        if (images[idx].is_cover) { coverIdx = idx; break; }
      }
      if (coverIdx === -1 && images.length > 0) coverIdx = 0;

      var mainImgUrl = coverIdx >= 0 ? images[coverIdx].image_url : (p.image_url || '');

      function imgHtml(url, alt) {
        return url
          ? '<img src="' + url + '" alt="' + escHtml(alt) + '" loading="lazy" />'
          : '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%"><svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" opacity="0.15"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>';
      }

      var thumbsHtml = '';
      if (images.length > 1) {
        thumbsHtml = '<div class="product-thumbnails">';
        for (var idx = 0; idx < images.length; idx++) {
          var im = images[idx];
          thumbsHtml += '<div class="thumbnail-item' + (idx === coverIdx ? ' active' : '') + '" onclick="switchMainImage(\'' + im.image_url.replace(/'/g, "\\'") + '\', this)">' +
            '<img src="' + im.image_url + '" alt="' + escHtml(p.name) + '" loading="lazy" />' +
            (im.is_cover ? '<span class="thumb-cover-badge">封面</span>' : '') +
            '</div>';
        }
        thumbsHtml += '</div>';
      }

      var priceHtml = p.sale_price != null
        ? '<span class="product-price">' + _fmt(p.sale_price) + '</span><span class="product-original-price">' + _fmt(p.price) + '</span>'
        : '<span class="product-price">' + _fmt(p.price) + '</span>';

      var conditionLabels = { new: '全新', like_new: '近乎全新', used: '二手', refurbished: '整新品' };
      var conditionLabel = conditionLabels[p.condition] || p.condition;

      var stockHtml = p.stock > 0
        ? '<span class="meta-value">剩餘 ' + p.stock + ' 件</span>'
        : '<span class="meta-value out-of-stock">已售完</span>';

      var conditionMeta = '<div class="meta-item"><span class="meta-label">狀態</span><span class="condition-badge" data-condition="' + p.condition + '">' + conditionLabel + '</span></div>';
      var typeMeta = p.product_type === 'virtual'
        ? '<div class="meta-item"><span class="meta-label">類型</span><span class="condition-badge">虛擬商品</span></div>'
        : '';

      container.innerHTML = '<nav class="breadcrumb">' +
        '<a href="/">首頁</a><span class="breadcrumb-sep">/</span>' +
        '<a href="/products/">全部商品</a><span class="breadcrumb-sep">/</span>' +
        '<span class="breadcrumb-current">' + escHtml(p.name) + '</span></nav>' +
        '<div class="product-detail">' +
        '<div class="product-gallery"><div class="product-main-image" id="main-image-wrap">' + imgHtml(mainImgUrl, p.name) + '</div>' + thumbsHtml + '</div>' +
        '<div class="product-info">' +
        (p.category_name ? '<span class="product-category">' + escHtml(p.category_name) + '</span>' : '') +
        '<h1 class="product-name">' + escHtml(p.name) + '</h1>' +
        '<div class="product-pricing">' + priceHtml + '</div>' +
        '<div class="product-meta">' + conditionMeta + typeMeta + '<div class="meta-item"><span class="meta-label">庫存</span>' + stockHtml + '</div></div>' +
        (p.stock > 0 ?
          '<div class="product-actions">' +
          '<div class="quantity-selector">' +
          '<button class="qty-btn" id="qty-minus">−</button>' +
          '<input type="number" class="qty-input" id="qty-input" value="1" min="1" max="' + p.stock + '" />' +
          '<button class="qty-btn" id="qty-plus">+</button></div>' +
          '<button class="btn btn-primary btn-lg btn-block add-to-cart-btn" id="add-to-cart-btn" data-product-id="' + p.id + '" data-product-stock="' + p.stock + '">加入購物車</button>' +
          '</div>' : '') +
        '<div class="product-description"><h3>商品說明</h3><p>' + escHtml(p.description || '暫無說明') + '</p></div>' +
        '</div></div>';

      var minusBtn = document.getElementById('qty-minus');
      var plusBtn = document.getElementById('qty-plus');
      var input = document.getElementById('qty-input');
      var addBtn = document.getElementById('add-to-cart-btn');

      if (minusBtn && input) minusBtn.addEventListener('click', function() { var v = parseInt(input.value) || 1; if (v > 1) input.value = String(v - 1); });
      if (plusBtn && input) plusBtn.addEventListener('click', function() { var v = parseInt(input.value) || 1; if (v < p.stock) input.value = String(v + 1); });

      if (addBtn) {
        addBtn.addEventListener('click', async function() {
          var token = localStorage.getItem('shop_token');
          if (!token) { window.location.href = '/login/'; return; }
          addBtn.disabled = true;
          addBtn.textContent = '加入中...';
          try {
            var qty = parseInt(input.value) || 1;
            var cartRes = await fetch(API_URL + '/api/cart', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
              body: JSON.stringify({ product_id: p.id, quantity: qty }),
            });
            if (!cartRes.ok) {
              var err = await cartRes.json();
              throw new Error(err.detail || '加入購物車失敗');
            }
            var cart = await cartRes.json();
            localStorage.setItem('shop_cart_count', String(cart.item_count));
            var badge = document.getElementById('cart-badge');
            if (badge) { badge.textContent = String(cart.item_count); badge.style.display = 'flex'; }
            addBtn.textContent = '已加入！';
            setTimeout(function() { addBtn.textContent = '加入購物車'; addBtn.disabled = false; }, 1500);
          } catch (err) {
            var msg = (err instanceof TypeError) ? '目前網路出現狀況中，請稍後再試' : (err.message || '加入購物車失敗');
            alert(msg);
            addBtn.textContent = '加入購物車';
            addBtn.disabled = false;
          }
        });
      }
    } catch (e) {
      var isNetwork = (e instanceof TypeError);
      container.innerHTML = '<div style="padding:var(--sp-16) 0;text-align:center"><div style="font-size:48px;font-weight:300;color:var(--c-border);margin-bottom:var(--sp-4)">' + (isNetwork ? '⚠' : '404') + '</div><h2 style="font-weight:400;margin-bottom:var(--sp-4)">' + (isNetwork ? '目前網路出現狀況中，請稍後再試' : '商品不存在') + '</h2>' + (isNetwork ? '' : '<a href="/products/" class="btn btn-primary">瀏覽全部商品</a>') + '</div>';
    }
  });
</script>

<style is:global>
  .breadcrumb { display: flex; align-items: center; gap: var(--sp-2); padding: var(--sp-6) 0; font-size: var(--text-sm); color: var(--c-text-secondary); }
  .breadcrumb a { transition: color var(--duration) var(--ease); }
  .breadcrumb a:hover { color: var(--c-text); }
  .breadcrumb-sep { color: var(--c-text-light); }
  .breadcrumb-current { color: var(--c-text); }
  .product-detail { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-12); padding-bottom: var(--sp-16); }
  .product-main-image { aspect-ratio: 1; background: var(--c-bg-alt); border: 1px solid var(--c-border); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .product-main-image img { width: 100%; height: 100%; object-fit: cover; }
  .product-info { display: flex; flex-direction: column; gap: var(--sp-6); padding-top: var(--sp-4); }
  .product-category { font-size: var(--text-xs); color: var(--c-text-light); letter-spacing: 0.06em; text-transform: uppercase; }
  .product-info .product-name { font-size: var(--text-3xl); font-weight: 400; line-height: var(--leading-tight); }
  .product-pricing { display: flex; align-items: baseline; gap: var(--sp-3); }
  .product-price { font-size: var(--text-2xl); font-weight: 500; }
  .product-original-price { font-size: var(--text-base); color: var(--c-text-light); text-decoration: line-through; }
  .product-meta { display: flex; flex-direction: column; gap: var(--sp-3); padding: var(--sp-4) 0; border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border); }
  .meta-item { display: flex; align-items: center; gap: var(--sp-3); font-size: var(--text-sm); }
  .meta-label { color: var(--c-text-light); min-width: 48px; }
  .out-of-stock { color: var(--c-error); }
  .condition-badge {
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 2px var(--sp-2);
    border-radius: 3px;
    line-height: 1.4;
  }
  .condition-badge { background: var(--c-bg-dark); color: var(--c-text-inverse); border: 1px solid var(--c-bg-dark); }
  .product-actions { display: flex; gap: var(--sp-4); align-items: center; }
  .quantity-selector { display: flex; align-items: center; border: 1px solid var(--c-border); border-radius: var(--radius); }
  .qty-btn { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: var(--text-lg); color: var(--c-text-secondary); transition: background var(--duration) var(--ease); background: none; border: none; cursor: pointer; }
  .qty-btn:hover { background: var(--c-bg-alt); }
  .qty-input { width: 48px; height: 40px; text-align: center; border: none; border-left: 1px solid var(--c-border); border-right: 1px solid var(--c-border); font-size: var(--text-sm); -moz-appearance: textfield; outline: none; }
  .qty-input::-webkit-inner-spin-button, .qty-input::-webkit-outer-spin-button { -webkit-appearance: none; }
  .add-to-cart-btn { flex: 1; }
  .product-description h3 { font-size: var(--text-sm); font-weight: 500; margin-bottom: var(--sp-3); }
  .product-description p { font-size: var(--text-sm); color: var(--c-text-secondary); line-height: var(--leading-relaxed); }

  .product-gallery { display: flex; flex-direction: column; gap: var(--sp-3); }
  .product-thumbnails { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
  .thumbnail-item {
    width: 72px; height: 72px;
    border: 2px solid transparent;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    opacity: 0.6;
    transition: all var(--duration) var(--ease);
    position: relative;
    flex-shrink: 0;
  }
  .thumbnail-item:hover { opacity: 0.9; }
  .thumbnail-item.active { opacity: 1; border-color: var(--c-text); }
  .thumbnail-item img { width: 100%; height: 100%; object-fit: cover; }
  .thumb-cover-badge {
    position: absolute; bottom: 2px; left: 2px;
    background: var(--c-primary); color: #fff;
    font-size: 9px; padding: 0 4px; border-radius: 2px;
    line-height: 14px;
  }

  @media (max-width: 768px) { .product-detail { grid-template-columns: 1fr; gap: var(--sp-6); } }
</style>
