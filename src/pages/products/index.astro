---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';

const demoProducts = [
  { name: '有機棉質 T-Shirt', slug: 'organic-cotton-tee', price: 590, sale_price: null, image_url: '', category_name: '上衣' },
  { name: '亞麻寬褲', slug: 'linen-wide-pants', price: 1280, sale_price: 980, image_url: '', category_name: '下身' },
  { name: '手工陶瓷杯', slug: 'ceramic-cup', price: 450, sale_price: null, image_url: '', category_name: '生活' },
  { name: '極簡帆布包', slug: 'canvas-bag', price: 680, sale_price: null, image_url: '', category_name: '配件' },
  { name: '天然精油擴香', slug: 'essential-oil', price: 380, sale_price: 320, image_url: '', category_name: '生活' },
  { name: '純棉毛巾組', slug: 'cotton-towel-set', price: 520, sale_price: null, image_url: '', category_name: '生活' },
  { name: '羊毛襪三入組', slug: 'wool-socks', price: 360, sale_price: null, image_url: '', category_name: '配件' },
  { name: '不鏽鋼保溫瓶', slug: 'thermos-bottle', price: 780, sale_price: 650, image_url: '', category_name: '生活' },
  { name: '棉麻襯衫', slug: 'linen-shirt', price: 880, sale_price: null, image_url: '', category_name: '上衣' },
];
---

<BaseLayout title="全部商品 — 小羊農場">
  <Header />

  <main class="pt-header">
    <div class="container">
      <div class="page-header">
        <h1>全部商品</h1>
        <p class="text-secondary">共 {demoProducts.length} 件商品</p>
      </div>

      <div class="products-layout">
        <!-- Sidebar filters -->
        <aside class="sidebar hide-mobile">
          <div class="filter-group">
            <h3 class="filter-title">分類</h3>
            <a href="/products" class="filter-link active">全部</a>
            <a href="/products?category=clothing" class="filter-link">服飾</a>
            <a href="/products?category=life" class="filter-link">生活</a>
            <a href="/products?category=accessories" class="filter-link">配件</a>
          </div>

          <div class="filter-group">
            <h3 class="filter-title">排序</h3>
            <a href="/products?sort=newest" class="filter-link active">最新</a>
            <a href="/products?sort=price_asc" class="filter-link">價格：低到高</a>
            <a href="/products?sort=price_desc" class="filter-link">價格：高到低</a>
          </div>
        </aside>

        <!-- Product grid -->
        <div class="products-grid">
          <!-- Mobile filters -->
          <div class="mobile-filters hide-desktop">
            <select class="form-input" onchange="window.location.href='?sort='+this.value">
              <option value="newest">最新</option>
              <option value="price_asc">價格：低到高</option>
              <option value="price_desc">價格：高到低</option>
            </select>
          </div>

          <div class="grid grid-3">
            {demoProducts.map((p) => (
              <ProductCard
                name={p.name}
                slug={p.slug}
                price={p.price}
                sale_price={p.sale_price}
                image_url={p.image_url}
                category_name={p.category_name}
              />
            ))}
          </div>

          <div class="pagination">
            <button class="btn btn-secondary btn-sm" disabled>← 上一頁</button>
            <span class="text-sm text-secondary">1 / 1</span>
            <button class="btn btn-secondary btn-sm" disabled>下一頁 →</button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: var(--sp-10) 0;
    border-bottom: 1px solid var(--c-border);
    margin-bottom: var(--sp-8);
  }

  .page-header h1 {
    font-size: var(--text-3xl);
    font-weight: 400;
    margin-bottom: var(--sp-2);
  }

  .products-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--sp-10);
    padding-bottom: var(--sp-16);
  }

  .sidebar {
    position: sticky;
    top: 80px;
    align-self: start;
  }

  .filter-group {
    margin-bottom: var(--sp-8);
  }

  .filter-title {
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-light);
    margin-bottom: var(--sp-3);
  }

  .filter-link {
    display: block;
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
    padding: var(--sp-1) 0;
    transition: color var(--duration) var(--ease);
  }

  .filter-link:hover, .filter-link.active {
    color: var(--c-text);
  }

  .mobile-filters {
    margin-bottom: var(--sp-4);
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    margin-top: var(--sp-10);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--c-border);
  }

  @media (max-width: 768px) {
    .products-layout {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }
  }
</style>
