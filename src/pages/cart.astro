---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AuthGuard from '../components/AuthGuard.astro';
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
---

<BaseLayout title="購物車 — 小羊農場">
  <AuthGuard />
  <Header />

  <main class="pt-header">
    <div class="container">
      <div class="page-header">
        <h1>購物車</h1>
      </div>

      <div id="cart-content" style="display:none">
        <div class="cart-layout">
          <div class="cart-items">
            <div class="cart-list" id="cart-list"></div>
          </div>
          <div class="cart-summary" id="cart-summary"></div>
        </div>
      </div>

      <div id="cart-not-logged-in" class="empty-state" style="display:none">
        <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <h3>請先登入</h3>
        <p>登入後即可使用購物車</p>
        <a href="/login/" class="btn btn-primary" style="margin-top:var(--sp-4)">登入</a>
      </div>

      <div id="cart-empty" class="empty-state" style="display:none">
        <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <h3>購物車是空的</h3>
        <p>快去逛逛吧！</p>
        <a href="/products/" class="btn btn-primary" style="margin-top:var(--sp-4)">開始選購</a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  var API_URL = window.location.hostname === 'shop.nsir.uk' ? 'https://shopbackend.nsir.uk' : 'http://localhost:8000';
  document.addEventListener('DOMContentLoaded', async function() {
    var token = localStorage.getItem('shop_token');

    if (!token) {
      document.getElementById('cart-not-logged-in').style.display = 'flex';
      return;
    }

    async function loadCart() {
      try {
        var res = await fetch(API_URL + '/api/cart', {
          headers: { 'Authorization': 'Bearer ' + token },
        });
        if (!res.ok) throw new Error('Failed');
        var cart = await res.json();
        localStorage.setItem('shop_cart_count', String(cart.item_count));

        if (!cart.items.length) {
          document.getElementById('cart-empty').style.display = 'flex';
          document.getElementById('cart-content').style.display = 'none';
          return;
        }

        document.getElementById('cart-content').style.display = 'block';
        document.getElementById('cart-empty').style.display = 'none';

        var listHtml = cart.items.map(function(item) {
          var imgHtml = item.product_image
            ? '<img src="' + item.product_image + '" alt="' + item.product_name + '" loading="lazy" />'
            : '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>';

          var displayPrice = item.sale_price || item.price;

          return '<div class="cart-item" data-id="' + item.id + '">' +
            '<div class="cart-item-image">' + imgHtml + '</div>' +
            '<div class="cart-item-info">' +
            '<a href="/products/' + item.product_slug + '/" class="cart-item-name">' + item.product_name + '</a>' +
            '<div class="cart-item-price">NT$' + displayPrice.toLocaleString() + '</div>' +
            '<div class="cart-item-qty">' +
            '<button class="qty-btn" onclick="updateQty(' + item.id + ',' + (item.quantity - 1) + ')">−</button>' +
            '<span class="qty-display">' + item.quantity + '</span>' +
            '<button class="qty-btn" onclick="updateQty(' + item.id + ',' + (item.quantity + 1) + ')">+</button>' +
            '</div></div>' +
            '<div class="cart-item-subtotal"><span class="cart-item-subtotal-label">小計</span><span>NT$' + item.subtotal.toLocaleString() + '</span></div>' +
            '<button class="cart-item-remove" onclick="removeItem(' + item.id + ')" aria-label="移除">' +
            '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
            '</button></div>';
        }).join('');

        document.getElementById('cart-list').innerHTML = listHtml;

        document.getElementById('cart-summary').innerHTML =
          '<h3>訂單摘要</h3>' +
          '<div class="summary-row"><span>商品數量</span><span>' + cart.item_count + ' 件</span></div>' +
          '<div class="summary-row"><span>運費</span><span>免運費</span></div>' +
          '<hr class="divider" />' +
          '<div class="summary-row summary-total"><span>合計</span><span>NT$' + cart.total.toLocaleString() + '</span></div>' +
          '<a href="/checkout/" class="btn btn-primary btn-block btn-lg" style="margin-top:var(--sp-6)">前往結帳</a>' +
          '<a href="/products/" class="btn btn-ghost btn-block" style="margin-top:var(--sp-2)">繼續選購</a>';

        var badge = document.getElementById('cart-badge');
        if (badge && cart.item_count > 0) {
          badge.textContent = String(cart.item_count);
          badge.style.display = 'flex';
        }
      } catch (e) {
        document.getElementById('cart-list').innerHTML = '<div class="text-center text-secondary" style="padding:var(--sp-8)">目前網路出現狀況中，請稍後再試</div>';
      }
    }

    window.updateQty = async function(itemId, qty) {
      if (qty < 1) { await removeItem(itemId); return; }
      try {
        await fetch(API_URL + '/api/cart/' + itemId, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify({ quantity: qty }),
        });
        loadCart();
      } catch (e) { alert('目前網路出現狀況中，請稍後再試'); }
    };

    window.removeItem = async function(itemId) {
      if (!confirm('確定要移除此商品？')) return;
      try {
        await fetch(API_URL + '/api/cart/' + itemId, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + token },
        });
        loadCart();
      } catch (e) { alert('目前網路出現狀況中，請稍後再試'); }
    };

    loadCart();
  });
</script>

<style>
  .page-header { padding: var(--sp-10) 0; border-bottom: 1px solid var(--c-border); margin-bottom: var(--sp-8); }
  .page-header h1 { font-size: var(--text-3xl); font-weight: 400; }
  .cart-layout { display: grid; grid-template-columns: 1fr 320px; gap: var(--sp-10); padding-bottom: var(--sp-16); }
  .cart-item { display: grid; grid-template-columns: 80px 1fr auto auto; gap: var(--sp-4); align-items: center; padding: var(--sp-4) 0; border-bottom: 1px solid var(--c-border); }
  .cart-item-image { width: 80px; height: 80px; background: var(--c-bg-alt); border: 1px solid var(--c-border); overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .cart-item-image img { width: 100%; height: 100%; object-fit: cover; }
  .cart-item-name { font-size: var(--text-sm); font-weight: 500; display: block; margin-bottom: var(--sp-1); }
  .cart-item-name:hover { text-decoration: underline; }
  .cart-item-price { font-size: var(--text-sm); color: var(--c-text-secondary); }
  .cart-item-qty { display: flex; align-items: center; margin-top: var(--sp-2); border: 1px solid var(--c-border); border-radius: var(--radius); width: fit-content; }
  .cart-item-qty .qty-btn { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; font-size: var(--text-sm); color: var(--c-text-secondary); background: none; border: none; cursor: pointer; }
  .cart-item-qty .qty-btn:hover { background: var(--c-bg-alt); }
  .qty-display { width: 32px; text-align: center; font-size: var(--text-sm); border-left: 1px solid var(--c-border); border-right: 1px solid var(--c-border); line-height: 28px; }
  .cart-item-subtotal { text-align: right; font-size: var(--text-sm); font-weight: 500; }
  .cart-item-subtotal-label { display: block; font-size: var(--text-xs); color: var(--c-text-light); font-weight: 400; margin-bottom: var(--sp-1); }
  .cart-item-remove { color: var(--c-text-light); padding: var(--sp-1); background: none; border: none; cursor: pointer; transition: color var(--duration) var(--ease); }
  .cart-item-remove:hover { color: var(--c-error); }
  .cart-summary { position: sticky; top: 80px; align-self: start; padding: var(--sp-6); border: 1px solid var(--c-border); border-radius: var(--radius); background: var(--c-bg-alt); }
  .cart-summary h3 { font-size: var(--text-base); font-weight: 500; margin-bottom: var(--sp-4); }
  .summary-row { display: flex; justify-content: space-between; font-size: var(--text-sm); color: var(--c-text-secondary); margin-bottom: var(--sp-2); }
  .summary-total { font-size: var(--text-base); font-weight: 500; color: var(--c-text); }
  .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: var(--sp-16) 0; text-align: center; }
  .empty-state h3 { font-size: var(--text-lg); font-weight: 400; margin-top: var(--sp-4); }
  .empty-state p { color: var(--c-text-secondary); font-size: var(--text-sm); margin-top: var(--sp-2); }
  @media (max-width: 768px) {
    .cart-layout { grid-template-columns: 1fr; gap: var(--sp-6); }
    .cart-item { grid-template-columns: 60px 1fr auto; }
    .cart-item-subtotal { grid-column: 2; }
    .cart-item-remove { grid-column: 3; grid-row: 1; }
  }
</style>
