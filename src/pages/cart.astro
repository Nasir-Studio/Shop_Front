---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const demoCartItems = [
  { id: 1, product_name: '有機棉質 T-Shirt', product_slug: 'organic-cotton-tee', product_image: '', price: 590, sale_price: null, quantity: 2, subtotal: 1180 },
  { id: 2, product_name: '手工陶瓷杯', product_slug: 'ceramic-cup', product_image: '', price: 450, sale_price: null, quantity: 1, subtotal: 450 },
];
const total = demoCartItems.reduce((sum, i) => sum + i.subtotal, 0);
---

<BaseLayout title="購物車 — 小羊農場">
  <Header />

  <main class="pt-header">
    <div class="container">
      <div class="page-header">
        <h1>購物車</h1>
      </div>

      <div id="cart-content">
        <div class="cart-layout">
          <div class="cart-items">
            <div class="cart-list">
              {demoCartItems.map((item) => (
                <div class="cart-item" data-id={item.id}>
                  <div class="cart-item-image">
                    {item.product_image ? (
                      <img src={item.product_image} alt={item.product_name} />
                    ) : (
                      <div class="cart-placeholder">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2">
                          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                          <circle cx="8.5" cy="8.5" r="1.5"/>
                          <polyline points="21 15 16 10 5 21"/>
                        </svg>
                      </div>
                    )}
                  </div>
                  <div class="cart-item-info">
                    <a href={`/products/${item.product_slug}`} class="cart-item-name">{item.product_name}</a>
                    <div class="cart-item-price">
                      NT${item.price.toLocaleString()}
                    </div>
                    <div class="cart-item-qty">
                      <button class="qty-btn">−</button>
                      <span class="qty-display">{item.quantity}</span>
                      <button class="qty-btn">+</button>
                    </div>
                  </div>
                  <div class="cart-item-subtotal">
                    <span class="cart-item-subtotal-label">小計</span>
                    <span>NT${item.subtotal.toLocaleString()}</span>
                  </div>
                  <button class="cart-item-remove" aria-label="移除">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
                      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <div class="cart-summary">
            <h3>訂單摘要</h3>
            <div class="summary-row">
              <span>商品數量</span>
              <span>{demoCartItems.reduce((s, i) => s + i.quantity, 0)} 件</span>
            </div>
            <div class="summary-row">
              <span>運費</span>
              <span>免運費</span>
            </div>
            <hr class="divider" />
            <div class="summary-row summary-total">
              <span>合計</span>
              <span>NT${total.toLocaleString()}</span>
            </div>
            <a href="/checkout" class="btn btn-primary btn-block btn-lg" style="margin-top: var(--sp-6)">
              前往結帳
            </a>
            <a href="/products" class="btn btn-ghost btn-block" style="margin-top: var(--sp-2)">
              繼續選購
            </a>
          </div>
        </div>
      </div>

      <div id="cart-empty" class="empty-state" style="display:none">
        <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <h3>購物車是空的</h3>
        <p>快去逛逛吧！</p>
        <a href="/products" class="btn btn-primary" style="margin-top: var(--sp-4)">開始選購</a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: var(--sp-10) 0;
    border-bottom: 1px solid var(--c-border);
    margin-bottom: var(--sp-8);
  }

  .page-header h1 {
    font-size: var(--text-3xl);
    font-weight: 400;
  }

  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--sp-10);
    padding-bottom: var(--sp-16);
  }

  .cart-item {
    display: grid;
    grid-template-columns: 80px 1fr auto auto;
    gap: var(--sp-4);
    align-items: center;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--c-border);
  }

  .cart-item-image {
    width: 80px;
    height: 80px;
    background: var(--c-bg-alt);
    border: 1px solid var(--c-border);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item-name {
    font-size: var(--text-sm);
    font-weight: 500;
    display: block;
    margin-bottom: var(--sp-1);
  }

  .cart-item-name:hover { text-decoration: underline; }

  .cart-item-price {
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }

  .cart-item-qty {
    display: flex;
    align-items: center;
    gap: 0;
    margin-top: var(--sp-2);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    width: fit-content;
  }

  .cart-item-qty .qty-btn {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }

  .qty-display {
    width: 32px;
    text-align: center;
    font-size: var(--text-sm);
    border-left: 1px solid var(--c-border);
    border-right: 1px solid var(--c-border);
    line-height: 28px;
  }

  .cart-item-subtotal {
    text-align: right;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .cart-item-subtotal-label {
    display: block;
    font-size: var(--text-xs);
    color: var(--c-text-light);
    font-weight: 400;
    margin-bottom: var(--sp-1);
  }

  .cart-item-remove {
    color: var(--c-text-light);
    padding: var(--sp-1);
    transition: color var(--duration) var(--ease);
  }

  .cart-item-remove:hover { color: var(--c-error); }

  .cart-summary {
    position: sticky;
    top: 80px;
    align-self: start;
    padding: var(--sp-6);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-bg-alt);
  }

  .cart-summary h3 {
    font-size: var(--text-base);
    font-weight: 500;
    margin-bottom: var(--sp-4);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
    margin-bottom: var(--sp-2);
  }

  .summary-total {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--c-text);
  }

  @media (max-width: 768px) {
    .cart-layout {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    .cart-item {
      grid-template-columns: 60px 1fr auto;
    }

    .cart-item-subtotal { grid-column: 2; }
    .cart-item-remove { grid-column: 3; grid-row: 1; }
  }
</style>
