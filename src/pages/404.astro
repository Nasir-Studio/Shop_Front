---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="找不到頁面 — 小羊農場">
  <Header />

  <main class="pt-header">
    <div class="container">
      <div class="error-page">
        <div class="error-code">404</div>
        <h1 class="error-title">找不到頁面</h1>
        <p class="error-desc">你所尋找的頁面不存在，或已被移除。</p>
        <div class="error-actions">
          <a href="/" class="btn btn-primary">回到首頁</a>
          <a href="/products/" class="btn btn-secondary">瀏覽商品</a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .error-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    padding: var(--sp-16) 0;
  }

  .error-code {
    font-size: 120px;
    font-weight: 300;
    color: var(--c-border);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: var(--sp-6);
  }

  .error-title {
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--c-text);
    margin-bottom: var(--sp-4);
  }

  .error-desc {
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
    margin-bottom: var(--sp-8);
    max-width: 360px;
  }

  .error-actions {
    display: flex;
    gap: var(--sp-4);
  }

  @media (max-width: 480px) {
    .error-code {
      font-size: 80px;
    }
    .error-actions {
      flex-direction: column;
    }
  }
</style>
