---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AuthGuard from '../../components/AuthGuard.astro';
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
---

<BaseLayout title="我的帳號 — 小羊農場">
  <AuthGuard />
  <Header />

  <main class="pt-header">
    <div class="container">
      <div class="page-header">
        <h1>我的帳號</h1>
      </div>

      <div id="account-not-logged" class="empty-state" style="display:none">
        <h3>請先登入</h3>
        <a href="/login/" class="btn btn-primary" style="margin-top:var(--sp-4)">登入</a>
      </div>

      <div class="account-layout" id="account-content" style="display:none">
        <nav class="account-nav">
          <a href="#profile" class="account-nav-link active" data-tab="profile">個人資料</a>
          <a href="#orders" class="account-nav-link" data-tab="orders">我的訂單</a>
        </nav>

        <div class="account-content">
          <div class="tab-panel" id="tab-profile">
            <h2>個人資料</h2>
            <form class="profile-form" id="profile-form">
              <div class="form-group">
                <label class="form-label">姓名</label>
                <input type="text" class="form-input" name="name" id="profile-name" />
              </div>
              <div class="form-group">
                <label class="form-label">電子郵件</label>
                <input type="email" class="form-input" id="profile-email" disabled />
              </div>
              <div class="form-group">
                <label class="form-label">電話</label>
                <input type="tel" class="form-input" name="phone" id="profile-phone" placeholder="請輸入電話號碼" />
              </div>
              <div class="form-group">
                <label class="form-label">地址</label>
                <textarea class="form-input" name="address" id="profile-address" placeholder="請輸入地址" rows="3"></textarea>
              </div>
              <div id="profile-msg" class="profile-msg" style="display:none"></div>
              <button type="submit" class="btn btn-primary">儲存修改</button>
            </form>
          </div>

          <div class="tab-panel" id="tab-orders" style="display:none">
            <h2>我的訂單</h2>
            <div id="orders-list"></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

  <script is:inline>
  var API_URL = window.location.hostname === 'shop.nsir.uk' ? 'https://shopbackend.nsir.uk' : 'http://localhost:8000';
  document.addEventListener('DOMContentLoaded', async function() {
    var token = localStorage.getItem('shop_token');
    var userStr = localStorage.getItem('shop_user');
    var user = userStr ? JSON.parse(userStr) : null;

    if (!token || !user) {
      document.getElementById('account-not-logged').style.display = 'flex';
      return;
    }

    // ── Fill from localStorage FIRST, then show (no white flash) ──
    document.getElementById('profile-name').value = user.name || '';
    document.getElementById('profile-email').value = user.email || '';
    document.getElementById('profile-phone').value = user.phone || '';
    document.getElementById('profile-address').value = user.address || '';

    document.getElementById('account-content').style.display = 'grid';

    // ── Then fetch fresh profile from API in background ──
    try {
      var profileRes = await fetch(API_URL + '/api/auth/me', {
        headers: { 'Authorization': 'Bearer ' + token },
      });
      if (profileRes.ok) {
        user = await profileRes.json();
        localStorage.setItem('shop_user', JSON.stringify(user));
        document.getElementById('profile-name').value = user.name || '';
        document.getElementById('profile-email').value = user.email || '';
        document.getElementById('profile-phone').value = user.phone || '';
        document.getElementById('profile-address').value = user.address || '';
      }
    } catch (e) {
      // Silently use cached data — user already sees localStorage values
    }

    // Check for order success redirect
    var urlParams = new URLSearchParams(window.location.search);
    var orderId = urlParams.get('order_success');
    if (orderId) {
      alert('訂單 #' + orderId + ' 已建立成功！');
      window.history.replaceState({}, '', '/account/');
    }

    // Tab switching
    document.querySelectorAll('.account-nav-link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        document.querySelectorAll('.account-nav-link').forEach(function(l) { l.classList.remove('active'); });
        link.classList.add('active');
        document.querySelectorAll('.tab-panel').forEach(function(p) { p.style.display = 'none'; });
        document.getElementById('tab-' + link.dataset.tab).style.display = 'block';

        if (link.dataset.tab === 'orders') loadOrders();
      });
    });

    // Profile form
    document.getElementById('profile-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      var formData = new FormData(e.target);
      var msgEl = document.getElementById('profile-msg');
      try {
        var res = await fetch(API_URL + '/api/auth/me', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify({
            name: formData.get('name'),
            phone: formData.get('phone'),
            address: formData.get('address'),
          }),
        });
        if (!res.ok) throw new Error('更新失敗');
        var updated = await res.json();
        localStorage.setItem('shop_user', JSON.stringify(updated));
        msgEl.textContent = '個人資料已更新';
        msgEl.className = 'profile-msg success';
        msgEl.style.display = 'block';
        setTimeout(function() { msgEl.style.display = 'none'; }, 3000);
      } catch (err) {
        var msg = (err instanceof TypeError) ? '目前網路出現狀況中，請稍後再試' : (err.message || '更新失敗');
        msgEl.textContent = msg;
        msgEl.className = 'profile-msg error';
        msgEl.style.display = 'block';
      }
    });

    // Load orders
    async function loadOrders() {
      var container = document.getElementById('orders-list');
      try {
        var res = await fetch(API_URL + '/api/orders', {
          headers: { 'Authorization': 'Bearer ' + token },
        });
        if (!res.ok) throw new Error();
        var orders = await res.json();

        if (!orders.length) {
          container.innerHTML = '<div class="empty-state"><svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><p>還沒有任何訂單</p><a href="/products/" class="btn btn-primary" style="margin-top:var(--sp-4)">開始選購</a></div>';
          return;
        }

        var statusMap = { pending: '待付款', paid: '已付款', shipped: '已出貨', completed: '已完成', cancelled: '已取消' };
        container.innerHTML = orders.map(function(o) {
          var date = new Date(o.created_at).toLocaleDateString('zh-TW');
          return '<div class="order-item"><div class="order-item-header"><span class="order-id">#' + o.id + '</span><span class="order-date">' + date + '</span></div><div class="order-item-body"><span class="order-items-count">' + o.item_count + ' 件商品</span><span class="order-status status-' + o.status + '">' + (statusMap[o.status] || o.status) + '</span></div><div class="order-item-footer"><span class="order-total">NT$' + o.total.toLocaleString() + '</span></div></div>';
        }).join('');
      } catch (e) {
        container.innerHTML = '<div class="text-center text-secondary" style="padding:var(--sp-8)">目前網路出現狀況中，請稍後再試</div>';
      }
    }
  });
</script>

<style>
  .page-header { padding: var(--sp-10) 0; border-bottom: 1px solid var(--c-border); margin-bottom: var(--sp-8); }
  .page-header h1 { font-size: var(--text-3xl); font-weight: 400; }
  .account-layout { display: grid; grid-template-columns: 180px 1fr; gap: var(--sp-10); padding-bottom: var(--sp-16); }
  .account-nav { position: sticky; top: 80px; align-self: start; }
  .account-nav-link { display: block; padding: var(--sp-2) var(--sp-4); font-size: var(--text-sm); color: var(--c-text-secondary); border-left: 2px solid transparent; transition: all var(--duration) var(--ease); margin-bottom: var(--sp-1); }
  .account-nav-link:hover { color: var(--c-text); }
  .account-nav-link.active { color: var(--c-text); border-left-color: var(--c-text); font-weight: 500; }
  .account-content h2 { font-size: var(--text-xl); font-weight: 400; margin-bottom: var(--sp-6); }
  .profile-form { display: flex; flex-direction: column; gap: var(--sp-5); max-width: 480px; }
  .profile-msg { padding: var(--sp-3) var(--sp-4); font-size: var(--text-sm); border-radius: var(--radius); }
  .profile-msg.success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
  .profile-msg.error { background: #fef2f2; border: 1px solid #fecaca; color: var(--c-error); }
  .order-item { padding: var(--sp-4) 0; border-bottom: 1px solid var(--c-border); }
  .order-item-header { display: flex; justify-content: space-between; margin-bottom: var(--sp-2); }
  .order-id { font-weight: 500; font-size: var(--text-sm); }
  .order-date { font-size: var(--text-xs); color: var(--c-text-light); }
  .order-item-body { display: flex; justify-content: space-between; font-size: var(--text-sm); color: var(--c-text-secondary); margin-bottom: var(--sp-2); }
  .order-item-footer { display: flex; justify-content: flex-end; }
  .order-total { font-weight: 500; font-size: var(--text-sm); }
  .order-status { font-size: var(--text-xs); padding: 2px 8px; border-radius: 999px; background: var(--c-bg-alt); }
  .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: var(--sp-16) 0; text-align: center; }
  .empty-state h3 { font-size: var(--text-lg); font-weight: 400; margin-top: var(--sp-4); }
  .empty-state p { color: var(--c-text-secondary); font-size: var(--text-sm); margin-top: var(--sp-2); }
  @media (max-width: 768px) {
    .account-layout { grid-template-columns: 1fr; }
    .account-nav { position: static; display: flex; gap: var(--sp-4); border-bottom: 1px solid var(--c-border); padding-bottom: var(--sp-4); }
    .account-nav-link { border-left: none; border-bottom: 2px solid transparent; padding: var(--sp-2) 0; }
    .account-nav-link.active { border-left-color: transparent; border-bottom-color: var(--c-text); }
  }
</style>
