---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="結帳 — 小羊農場">
  <Header />

  <main class="pt-header">
    <div class="container">
      <div class="page-header">
        <h1>結帳</h1>
      </div>

      <div class="checkout-layout">
        <form class="checkout-form" id="checkout-form">
          <h2>收件資訊</h2>

          <div class="form-group">
            <label class="form-label">收件人姓名 *</label>
            <input type="text" class="form-input" name="shipping_name" required placeholder="請輸入收件人姓名" />
          </div>

          <div class="form-group">
            <label class="form-label">聯絡電話 *</label>
            <input type="tel" class="form-input" name="shipping_phone" required placeholder="請輸入聯絡電話" />
          </div>

          <div class="form-group">
            <label class="form-label">收件地址 *</label>
            <textarea class="form-input" name="shipping_address" required placeholder="請輸入完整收件地址" rows="3"></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">備註</label>
            <textarea class="form-input" name="note" placeholder="選填：配送備註或其他需求" rows="2"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-lg btn-block" id="submit-btn">
            確認訂購
          </button>
        </form>

        <div class="checkout-summary">
          <h3>訂單摘要</h3>
          <div class="summary-items">
            <div class="summary-item">
              <span>有機棉質 T-Shirt × 2</span>
              <span>NT$1,180</span>
            </div>
            <div class="summary-item">
              <span>手工陶瓷杯 × 1</span>
              <span>NT$450</span>
            </div>
          </div>
          <hr class="divider" />
          <div class="summary-row">
            <span>商品合計</span>
            <span>NT$1,630</span>
          </div>
          <div class="summary-row">
            <span>運費</span>
            <span>免運費</span>
          </div>
          <hr class="divider" />
          <div class="summary-row summary-total">
            <span>應付金額</span>
            <span>NT$1,630</span>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('checkout-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        const token = localStorage.getItem('shop_token');
        if (!token) {
          window.location.href = '/login';
          return;
        }
        alert('訂單已建立！（此為示範）');
      });
    }
  });
</script>

<style>
  .page-header {
    padding: var(--sp-10) 0;
    border-bottom: 1px solid var(--c-border);
    margin-bottom: var(--sp-8);
  }

  .page-header h1 {
    font-size: var(--text-3xl);
    font-weight: 400;
  }

  .checkout-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--sp-10);
    padding-bottom: var(--sp-16);
  }

  .checkout-form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .checkout-form h2 {
    font-size: var(--text-xl);
    font-weight: 400;
  }

  .checkout-summary {
    position: sticky;
    top: 80px;
    align-self: start;
    padding: var(--sp-6);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-bg-alt);
  }

  .checkout-summary h3 {
    font-size: var(--text-base);
    font-weight: 500;
    margin-bottom: var(--sp-4);
  }

  .summary-items {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .summary-item {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
    margin-bottom: var(--sp-2);
  }

  .summary-total {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--c-text);
  }

  @media (max-width: 768px) {
    .checkout-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
