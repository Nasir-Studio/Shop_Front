---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AuthGuard from '../components/AuthGuard.astro';
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
---

<BaseLayout title="結帳 — 小羊農場">
  <AuthGuard />
  <Header />

  <main class="pt-header">
    <div class="container">
      <div class="page-header">
        <h1>結帳</h1>
      </div>

      <div id="checkout-not-logged" class="empty-state" style="display:none">
        <h3>請先登入</h3>
        <p>登入後才能結帳</p>
        <a href="/login/" class="btn btn-primary" style="margin-top:var(--sp-4)">登入</a>
      </div>

      <div id="checkout-empty-cart" class="empty-state" style="display:none">
        <h3>購物車是空的</h3>
        <p>請先加入商品</p>
        <a href="/products/" class="btn btn-primary" style="margin-top:var(--sp-4)">瀏覽商品</a>
      </div>

      <div class="checkout-layout" id="checkout-layout" style="display:none">
        <form class="checkout-form" id="checkout-form" novalidate>
          <h2>配送方式</h2>
          <div class="shipping-toggle">
            <button type="button" class="shipping-option active" id="ship-home" data-method="home_delivery">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
              <div>
                <strong>宅配到府</strong>
                <span class="shipping-desc">送至指定地址</span>
              </div>
              <span class="check-mark">✓</span>
            </button>
            <button type="button" class="shipping-option" id="ship-store" data-method="store_pickup">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                <circle cx="12" cy="13" r="2"/>
              </svg>
              <div>
                <strong>超商取貨</strong>
                <span class="shipping-desc">7-11 / 全家 門市取貨</span>
              </div>
              <span class="check-mark">✓</span>
            </button>
            <button type="button" class="shipping-option" id="ship-meetup" data-method="meetup">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 21s-7-5.1-7-11a7 7 0 0114 0c0 5.9-7 11-7 11z"/>
                <circle cx="12" cy="10" r="2.5"/>
              </svg>
              <div>
                <strong>面交自取</strong>
                <span class="shipping-desc">免運費，時間地點另約</span>
              </div>
              <span class="check-mark">✓</span>
            </button>
          </div>

          <div id="delivery-section">
            <h2>收件資訊</h2>
            <div class="form-group">
              <label class="form-label">收件人姓名 *</label>
              <input type="text" class="form-input" name="shipping_name" id="input-name" required placeholder="請輸入收件人姓名" />
            </div>
            <div class="form-group">
              <label class="form-label">聯絡電話 *</label>
              <input type="tel" class="form-input" name="shipping_phone" id="input-phone" required placeholder="請輸入聯絡電話" />
            </div>
            <div class="form-group">
              <label class="form-label">收件地址 *</label>
              <textarea class="form-input" name="shipping_address" id="input-address" required placeholder="請輸入完整收件地址（含郵遞區號）" rows="3"></textarea>
            </div>
          </div>

          <div id="pickup-section" style="display:none">
            <h2>選擇超商門市</h2>
            <div class="store-type-selector">
              <button type="button" class="store-type-btn active" data-store-type="7-11">
                <span class="store-type-icon">7-11</span>
                <span>統一超商</span>
              </button>
              <button type="button" class="store-type-btn" data-store-type="family_mart">
                <span class="store-type-icon family">全家</span>
                <span>FamilyMart</span>
              </button>
            </div>

            <div class="form-group" style="position:relative">
              <label class="form-label">搜尋門市</label>
              <input type="text" class="form-input" id="store-search-input" placeholder="輸入門市名稱或代碼搜尋..." autocomplete="off" />
              <div id="store-search-status" class="store-search-status"></div>
            </div>

            <div id="store-results" class="store-results"></div>
            <div id="store-selected" class="store-selected" style="display:none"></div>

            <input type="hidden" name="store_type" id="store-type-input" />
            <input type="hidden" name="store_code" id="store-code-input" />
            <input type="hidden" name="store_name" id="store-name-input" />

            <h2 style="margin-top:var(--sp-8)">收件人資訊</h2>
            <div class="form-group">
              <label class="form-label">收件人姓名 *</label>
              <input type="text" class="form-input" name="shipping_name_pickup" id="input-name-pickup" required placeholder="請輸入收件人姓名" />
            </div>
            <div class="form-group">
              <label class="form-label">聯絡電話 *</label>
              <input type="tel" class="form-input" name="shipping_phone_pickup" id="input-phone-pickup" required placeholder="請輸入聯絡電話" />
            </div>
          </div>

          <div id="meetup-section" style="display:none">
            <h2>面交資訊</h2>
            <div class="form-group">
              <label class="form-label">聯絡人姓名 *</label>
              <input type="text" class="form-input" name="shipping_name_meetup" id="input-name-meetup" required placeholder="請輸入聯絡人姓名" />
            </div>
            <div class="form-group">
              <label class="form-label">聯絡電話 *</label>
              <input type="tel" class="form-input" name="shipping_phone_meetup" id="input-phone-meetup" required placeholder="請輸入聯絡電話" />
            </div>
            <div class="shipping-note">面交時間與地點將由我們與您聯繫確認，本方式免運費。</div>
          </div>

          <div id="virtual-section" style="display:none">
            <h2>虛擬商品</h2>
            <div class="shipping-note">本訂單僅含虛擬商品，無需運送，請填寫聯絡資訊以便交付商品。</div>
            <div class="form-group">
              <label class="form-label">聯絡人姓名 *</label>
              <input type="text" class="form-input" name="shipping_name_virtual" id="input-name-virtual" required placeholder="請輸入聯絡人姓名" />
            </div>
            <div class="form-group">
              <label class="form-label">聯絡電話 *</label>
              <input type="tel" class="form-input" name="shipping_phone_virtual" id="input-phone-virtual" required placeholder="請輸入聯絡電話" />
            </div>
          </div>

          <h2>備註</h2>
          <div class="form-group">
            <textarea class="form-input" name="note" id="input-note" placeholder="選填：配送備註或其他需求" rows="2"></textarea>
          </div>

          <h2>付款方式</h2>
          <div class="payment-grid">
            <label class="payment-option active" data-payment="cash">
              <input type="radio" name="payment_method" value="cash" checked hidden />
              <span class="payment-icon">$</span>
              <span class="payment-label">現金</span>
              <span class="payment-check">✓</span>
            </label>
            <label class="payment-option" data-payment="bank_transfer">
              <input type="radio" name="payment_method" value="bank_transfer" hidden />
              <span class="payment-icon">&#9776;</span>
              <span class="payment-label">銀行轉帳</span>
              <span class="payment-check">✓</span>
            </label>
            <label class="payment-option" data-payment="line_pay">
              <input type="radio" name="payment_method" value="line_pay" hidden />
              <span class="payment-icon linepay">LINE</span>
              <span class="payment-label">Line Pay</span>
              <span class="payment-check">✓</span>
            </label>
            <label class="payment-option" data-payment="crypto">
              <input type="radio" name="payment_method" value="crypto" hidden />
              <span class="payment-icon crypto">&#8383;</span>
              <span class="payment-label">虛擬貨幣</span>
              <span class="payment-check">✓</span>
            </label>
            <label class="payment-option" data-payment="paypal">
              <input type="radio" name="payment_method" value="paypal" hidden />
              <span class="payment-icon paypal">P</span>
              <span class="payment-label">PayPal</span>
              <span class="payment-check">✓</span>
            </label>
          </div>

          <div id="checkout-error" class="error-msg" style="display:none"></div>
          <button type="submit" class="btn btn-primary btn-lg btn-block" id="submit-btn">確認訂購</button>
        </form>
        <div class="checkout-summary" id="checkout-summary"></div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  var API_URL = window.location.hostname === 'shop.nsir.uk' ? 'https://shopbackend.nsir.uk' : 'http://localhost:8000';
  var __cc = window.__currency;
  function _fmt(ntd) {
    if (ntd === 0) return '<span data-ntd="0">免費</span>';
    if (__cc && __cc._rates) return __cc.format(ntd);
    return '<span data-ntd="' + ntd + '">NT$' + (ntd || 0).toLocaleString() + '</span>';
  }
  document.addEventListener('DOMContentLoaded', async function() {
    var token = localStorage.getItem('shop_token');

    if (!token) {
      document.getElementById('checkout-not-logged').style.display = 'flex';
      return;
    }

    var cart = null;
    try {
      var [cartRes, profileRes] = await Promise.all([
        fetch(API_URL + '/api/cart', { headers: { 'Authorization': 'Bearer ' + token } }),
        fetch(API_URL + '/api/auth/me', { headers: { 'Authorization': 'Bearer ' + token } }),
      ]);
      if (!cartRes.ok) throw new Error();
      cart = await cartRes.json();
      if (profileRes.ok) {
        var profile = await profileRes.json();
        var nameInput = document.getElementById('input-name');
        var phoneInput = document.getElementById('input-phone');
        var addrInput = document.getElementById('input-address');
        if (profile.name) nameInput.value = profile.name;
        if (profile.phone) phoneInput.value = profile.phone;
        if (profile.address) addrInput.value = profile.address;
        // 一併填入超商取貨／面交／虛擬商品欄位
        if (profile.name) document.getElementById('input-name-pickup').value = profile.name;
        if (profile.phone) document.getElementById('input-phone-pickup').value = profile.phone;
        if (profile.name) document.getElementById('input-name-meetup').value = profile.name;
        if (profile.phone) document.getElementById('input-phone-meetup').value = profile.phone;
        if (profile.name) document.getElementById('input-name-virtual').value = profile.name;
        if (profile.phone) document.getElementById('input-phone-virtual').value = profile.phone;
      }
    } catch (e) {
      alert('目前網路出現狀況中，請稍後再試');
      return;
    }

    if (!cart.items.length) {
      document.getElementById('checkout-empty-cart').style.display = 'flex';
      return;
    }

    document.getElementById('checkout-layout').style.display = 'grid';

    var allVirtual = cart.items.every(function(item) { return item.product_type === 'virtual'; });

    function shippingFeeFor(method) {
      if (method === 'meetup' || method === 'virtual') return 0;
      return 75;
    }
    function isFreeShipCoupon() {
      return appliedCoupon && appliedCoupon.discount_type === 'shipping';
    }
    function currentShippingFee() {
      return isFreeShipCoupon() ? 0 : shippingFeeFor(currentMethod);
    }

    var appliedCoupon = null;
    var couponInputVal = '';

    function renderSummary() {
      var itemsHtml = cart.items.map(function(item) {
        return '<div class="summary-item"><span>' + escHtml(item.product_name) + ' × ' + item.quantity + '</span><span>' + _fmt(item.subtotal) + '</span></div>';
      }).join('');
      var totalBeforeShip = cart.total;
      var freeShip = isFreeShipCoupon();
      var discount = appliedCoupon ? (freeShip ? 0 : appliedCoupon.discount_amount) : 0;
      var shipFee = currentShippingFee();
      var grandTotal = Math.max(totalBeforeShip - discount, 0) + shipFee;
      var couponBlock = '<div class="coupon-box">' +
        '<label class="form-label">優惠券</label>' +
        '<div class="coupon-row">' +
          '<input type="text" class="form-input coupon-input" id="coupon-input" placeholder="輸入優惠碼" value="' + escHtml(couponInputVal) + '" ' + (appliedCoupon ? 'disabled' : '') + ' />' +
          '<button type="button" class="btn btn-secondary coupon-btn" id="coupon-apply-btn" ' + (appliedCoupon ? 'style="display:none"' : '') + '>套用</button>' +
          '<button type="button" class="coupon-remove" id="coupon-remove-btn" ' + (appliedCoupon ? '' : 'style="display:none"') + '>移除</button>' +
        '</div>' +
        '<div id="coupon-status" class="coupon-status"></div>' +
      '</div>';
      document.getElementById('checkout-summary').innerHTML =
        '<div class="summary-secondhand-notice">⚠️ 所有商品皆為二手物品，請確認商品狀況後再索取</div>' +
        '<h3>訂單摘要</h3>' +
        '<div class="summary-items">' + itemsHtml + '</div>' +
        '<hr class="divider" />' +
        couponBlock +
        '<div class="summary-row"><span>商品合計</span><span>' + _fmt(totalBeforeShip) + '</span></div>' +
        (discount > 0 ? '<div class="summary-row summary-discount"><span>優惠折扣 <span class="shipping-breakdown">(' + escHtml(appliedCoupon.code) + ')</span></span><span>-' + _fmt(discount) + '</span></div>' : '') +
        (freeShip ? '<div class="summary-row summary-discount"><span>免運優惠 <span class="shipping-breakdown">(' + escHtml(appliedCoupon.code) + ')</span></span><span>-運費</span></div>' : '') +
        '<div class="summary-row">' +
          '<span>運費' + (shipFee === 0 ? ' <span class="shipping-breakdown">(免運)</span>' : ' <span class="shipping-breakdown">(運費 60 + 包材費 15)</span>') + '</span>' +
          '<span>' + _fmt(shipFee) + '</span>' +
        '</div>' +
        '<hr class="divider" />' +
        (grandTotal === 0 ? '<div class="zero-notice">此訂單無需付款</div>' : '') +
        '<div class="summary-row summary-total"><span>應付金額</span><span>' + _fmt(grandTotal) + '</span></div>';
      var applyBtn = document.getElementById('coupon-apply-btn');
      if (applyBtn) applyBtn.addEventListener('click', applyCoupon);
      var removeBtn = document.getElementById('coupon-remove-btn');
      if (removeBtn) removeBtn.addEventListener('click', removeCoupon);
    }
    renderSummary();

    function applyCoupon() {
      var input = document.getElementById('coupon-input');
      var status = document.getElementById('coupon-status');
      var code = input.value.trim();
      if (!code) {
        status.textContent = '請輸入優惠碼';
        status.className = 'coupon-status error';
        return;
      }
      status.textContent = '驗證中...';
      status.className = 'coupon-status loading';
      fetch(API_URL + '/api/coupons/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
        body: JSON.stringify({ code: code, subtotal: cart.total, shipping_fee: shippingFeeFor(currentMethod) }),
      })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.valid) {
          appliedCoupon = { code: res.code, discount_amount: res.discount_amount, discount_type: res.discount_type || 'fixed' };
          couponInputVal = res.code;
          if (appliedCoupon.discount_type === 'shipping') {
            status.textContent = '已套用優惠，本單免運費';
          } else {
            status.textContent = '已套用優惠，折扣 ' + 'NT$' + res.discount_amount.toLocaleString();
          }
          status.className = 'coupon-status success';
          renderSummary();
        } else {
          status.textContent = res.message || '優惠碼無效';
          status.className = 'coupon-status error';
        }
      })
      .catch(function() {
        status.textContent = '驗證失敗，請稍後再試';
        status.className = 'coupon-status error';
      });
    }

    function removeCoupon() {
      appliedCoupon = null;
      couponInputVal = '';
      renderSummary();
    }

    var currentMethod = 'home_delivery';
    var shipHome = document.getElementById('ship-home');
    var shipStore = document.getElementById('ship-store');
    var shipMeetup = document.getElementById('ship-meetup');
    var deliverySection = document.getElementById('delivery-section');
    var pickupSection = document.getElementById('pickup-section');
    var meetupSection = document.getElementById('meetup-section');
    var virtualSection = document.getElementById('virtual-section');

    shipHome.addEventListener('click', function() { setShippingMethod('home_delivery'); });
    shipStore.addEventListener('click', function() { setShippingMethod('store_pickup'); });
    shipMeetup.addEventListener('click', function() { setShippingMethod('meetup'); });

    function setShippingMethod(method) {
      currentMethod = method;
      shipHome.classList.toggle('active', method === 'home_delivery');
      shipStore.classList.toggle('active', method === 'store_pickup');
      shipMeetup.classList.toggle('active', method === 'meetup');
      deliverySection.style.display = method === 'home_delivery' ? 'block' : 'none';
      pickupSection.style.display = method === 'store_pickup' ? 'block' : 'none';
      meetupSection.style.display = method === 'meetup' ? 'block' : 'none';
      virtualSection.style.display = method === 'virtual' ? 'block' : 'none';
      renderSummary();
    }

    if (allVirtual) {
      currentMethod = 'virtual';
      document.querySelector('.shipping-toggle').style.display = 'none';
      shipHome.classList.remove('active');
      shipStore.classList.remove('active');
      shipMeetup.classList.remove('active');
      deliverySection.style.display = 'none';
      pickupSection.style.display = 'none';
      meetupSection.style.display = 'none';
      virtualSection.style.display = 'block';
      renderSummary();
    }

    var currentStoreType = '7-11';
    var storeSearchTimer = null;

    document.querySelectorAll('.store-type-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.store-type-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        currentStoreType = btn.dataset.storeType;
        clearStoreSelection();
        var kw = document.getElementById('store-search-input').value.trim();
        if (kw) searchStores(kw);
        else loadAllStores();
      });
    });

    var searchInput = document.getElementById('store-search-input');
    var searchStatus = document.getElementById('store-search-status');
    var resultsContainer = document.getElementById('store-results');
    var selectedContainer = document.getElementById('store-selected');

    searchInput.addEventListener('input', function() {
      clearTimeout(storeSearchTimer);
      var kw = this.value.trim();
      storeSearchTimer = setTimeout(function() {
        if (kw.length >= 1) searchStores(kw);
        else loadAllStores();
      }, 300);
    });

    function searchStores(keyword) {
      searchStatus.textContent = '搜尋中...';
      searchStatus.className = 'store-search-status loading';
      fetch(API_URL + '/api/orders/stores?type=' + currentStoreType + '&keyword=' + encodeURIComponent(keyword), {
        headers: { 'Authorization': 'Bearer ' + token },
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        searchStatus.textContent = '';
        renderStoreResults(data.stores);
      })
      .catch(function() {
        searchStatus.textContent = '搜尋失敗，請稍後再試';
        searchStatus.className = 'store-search-status error';
      });
    }

    function loadAllStores() {
      searchStatus.textContent = '載入門市...';
      searchStatus.className = 'store-search-status loading';
      fetch(API_URL + '/api/orders/stores?type=' + currentStoreType, {
        headers: { 'Authorization': 'Bearer ' + token },
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        searchStatus.textContent = '';
        renderStoreResults(data.stores);
      })
      .catch(function() {
        searchStatus.textContent = '';
      });
    }

    function renderStoreResults(stores) {
      if (!stores.length) {
        resultsContainer.innerHTML = '<div class="store-empty">找不到符合的門市，請嘗試其他關鍵字</div>';
        return;
      }
      resultsContainer.innerHTML = stores.map(function(s) {
        return '<div class="store-result" data-code="' + s.code + '" data-name="' + s.name + '" data-address="' + s.address + '">' +
          '<div class="store-result-info">' +
          '<span class="store-result-name">' + s.name + '</span>' +
          '<span class="store-result-addr">' + s.address + '</span>' +
          '</div>' +
          '<span class="store-result-code">' + s.code + '</span>' +
          '<span class="store-result-check">✓</span>' +
          '</div>';
      }).join('');

      resultsContainer.querySelectorAll('.store-result').forEach(function(el) {
        el.addEventListener('click', function() {
          selectStore(el.dataset.code, el.dataset.name, el.dataset.address);
        });
      });
    }

    function selectStore(code, name, address) {
      document.getElementById('store-type-input').value = currentStoreType;
      document.getElementById('store-code-input').value = code;
      document.getElementById('store-name-input').value = name;

      resultsContainer.innerHTML = '';
      searchInput.value = name + ' (' + code + ')';

      var typeLabel = currentStoreType === '7-11' ? '7-11' : '全家 FamilyMart';
      selectedContainer.style.display = 'flex';
      selectedContainer.innerHTML =
        '<div class="store-selected-info">' +
        '<span class="store-selected-badge">' + typeLabel + '</span>' +
        '<span class="store-selected-name">' + name + '</span>' +
        '<span class="store-selected-addr">' + address + '</span>' +
        '<span class="store-selected-code">門市代碼：' + code + '</span>' +
        '</div>' +
        '<button type="button" class="store-change-btn" onclick="clearStoreSelection()">更換門市</button>';
    }

    window.clearStoreSelection = function() {
      document.getElementById('store-type-input').value = '';
      document.getElementById('store-code-input').value = '';
      document.getElementById('store-name-input').value = '';
      selectedContainer.style.display = 'none';
      selectedContainer.innerHTML = '';
      searchInput.value = '';
      loadAllStores();
    };

    function clearStoreSelection() {
      document.getElementById('store-type-input').value = '';
      document.getElementById('store-code-input').value = '';
      document.getElementById('store-name-input').value = '';
      selectedContainer.style.display = 'none';
      selectedContainer.innerHTML = '';
      searchInput.value = '';
    }

    loadAllStores();

    document.querySelectorAll('.payment-option').forEach(function(opt) {
      opt.addEventListener('click', function() {
        document.querySelectorAll('.payment-option').forEach(function(o) { o.classList.remove('active'); });
        opt.classList.add('active');
        opt.querySelector('input[type="radio"]').checked = true;
      });
    });

    document.getElementById('checkout-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      var errorEl = document.getElementById('checkout-error');
      var submitBtn = document.getElementById('submit-btn');

      var shippingName, shippingPhone, shippingAddress;
      var storeType = document.getElementById('store-type-input').value;
      var storeCode = document.getElementById('store-code-input').value;
      var storeName = document.getElementById('store-name-input').value;

      if (currentMethod === 'home_delivery') {
        shippingName = document.getElementById('input-name').value.trim();
        shippingPhone = document.getElementById('input-phone').value.trim();
        shippingAddress = document.getElementById('input-address').value.trim();
        if (!shippingAddress) {
          errorEl.textContent = '請輸入收件地址';
          errorEl.style.display = 'block';
          return;
        }
      } else if (currentMethod === 'store_pickup') {
        shippingName = document.getElementById('input-name-pickup').value.trim();
        shippingPhone = document.getElementById('input-phone-pickup').value.trim();
        shippingAddress = '';
        if (!storeCode || !storeName) {
          errorEl.textContent = '請選擇超商門市';
          errorEl.style.display = 'block';
          return;
        }
      } else if (currentMethod === 'meetup') {
        shippingName = document.getElementById('input-name-meetup').value.trim();
        shippingPhone = document.getElementById('input-phone-meetup').value.trim();
        shippingAddress = '';
      } else {
        shippingName = document.getElementById('input-name-virtual').value.trim();
        shippingPhone = document.getElementById('input-phone-virtual').value.trim();
        shippingAddress = '';
      }

      if (!shippingName || !shippingPhone) {
        errorEl.textContent = '請填寫收件人姓名與聯絡電話';
        errorEl.style.display = 'block';
        return;
      }

      var paymentMethod = document.querySelector('input[name="payment_method"]:checked');
      if (!paymentMethod) {
        errorEl.textContent = '請選擇付款方式';
        errorEl.style.display = 'block';
        return;
      }

      errorEl.style.display = 'none';
      submitBtn.disabled = true;
      submitBtn.textContent = '處理中...';

      try {
        var body = {
          shipping_name: shippingName,
          shipping_phone: shippingPhone,
          shipping_address: shippingAddress,
          note: document.getElementById('input-note').value.trim() || '',
          shipping_method: currentMethod,
          shipping_fee: currentShippingFee(),
          store_type: currentMethod === 'store_pickup' ? storeType : null,
          store_code: currentMethod === 'store_pickup' ? storeCode : null,
          store_name: currentMethod === 'store_pickup' ? storeName : null,
          payment_method: paymentMethod.value,
          coupon_code: appliedCoupon ? appliedCoupon.code : '',
        };

        var orderRes = await fetch(API_URL + '/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify(body),
        });

        if (!orderRes.ok) {
          var err = await orderRes.json();
          throw new Error(err.detail || '建立訂單失敗');
        }

        var order = await orderRes.json();
        localStorage.setItem('shop_cart_count', '0');
        window.location.href = '/account/?order_success=' + order.id;
      } catch (err) {
        var msg = (err instanceof TypeError) ? '目前網路出現狀況中，請稍後再試' : (err.message || '建立訂單失敗');
        errorEl.textContent = msg;
        errorEl.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = '確認訂購';
      }
    });
  });
</script>

