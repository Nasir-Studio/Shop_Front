---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
---

<BaseLayout title="0元活動專區 — 小羊農場">
  <Header />

  <main class="pt-header">
    <div class="container">
      <div class="page-header">
        <h1>0元活動專區</h1>
        <p class="text-secondary" id="product-count">載入中...</p>
      </div>

      <div class="intro-banner">
        <p>所有商品皆以 <strong>0 元</strong> 分享，只需負擔運費即可帶回家！讓不需要的物品找到新主人 🐑</p>
      </div>

      <div class="products-layout">
        <aside class="sidebar hide-mobile">
          <div class="filter-group">
            <h3 class="filter-title">分類</h3>
            <div id="category-filters">
              <a href="/zero-price" class="filter-link active">全部</a>
            </div>
          </div>
          <div class="filter-group">
            <h3 class="filter-title">排序</h3>
            <div id="sort-filters">
              <a href="#" class="filter-link active" data-sort="newest">最新</a>
              <a href="#" class="filter-link" data-sort="price_asc">價格：低到高</a>
              <a href="#" class="filter-link" data-sort="price_desc">價格：高到低</a>
            </div>
          </div>
        </aside>

        <div class="products-grid">
          <div class="mobile-filters hide-desktop">
            <select class="form-input" id="mobile-sort">
              <option value="newest">最新</option>
              <option value="price_asc">價格：低到高</option>
              <option value="price_desc">價格：高到低</option>
            </select>
          </div>

          <div class="grid grid-3" id="products-grid">
            <div class="text-center text-secondary" style="grid-column:1/-1;padding:var(--sp-16)">載入中...</div>
          </div>

          <div class="pagination" id="pagination"></div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  var API_URL = window.location.hostname === 'shop.nsir.uk' ? 'https://shopbackend.nsir.uk' : 'http://localhost:8000';
  var __cc = window.__currency;
  function _fmt(ntd) {
    if (ntd === 0) return '<span data-ntd="0">免費</span>';
    if (__cc && __cc._rates) return __cc.format(ntd);
    return '<span data-ntd="' + ntd + '">NT$' + (ntd || 0).toLocaleString() + '</span>';
  }

  document.addEventListener('DOMContentLoaded', async function() {
    var params = new URLSearchParams(window.location.search);
    var currentPage = parseInt(params.get('page') || '1');
    var currentCategory = params.get('category') || '';
    var currentSort = params.get('sort') || 'newest';
    var currentSearch = params.get('search') || '';

    function updateUrl() {
      var qs = new URLSearchParams();
      if (currentPage > 1) qs.set('page', String(currentPage));
      if (currentCategory) qs.set('category', currentCategory);
      if (currentSort !== 'newest') qs.set('sort', currentSort);
      if (currentSearch) qs.set('search', currentSearch);
      var url = '/zero-price/' + (qs.toString() ? '?' + qs : '');
      window.history.replaceState(null, '', url);
    }

    function showGridLoading() {
      var grid = document.getElementById('products-grid');
      grid.style.opacity = '0.4';
      grid.style.transition = 'opacity 0.15s ease';
    }
    function hideGridLoading() {
      var grid = document.getElementById('products-grid');
      grid.style.opacity = '1';
    }

    async function loadCategories() {
      try {
        var res = await fetch(API_URL + '/api/categories');
        if (!res.ok) return;
        var cats = await res.json();
        var container = document.getElementById('category-filters');
        var html = '<a href="#" class="filter-link' + (!currentCategory ? ' active' : '') + '" data-category="">全部</a>';
        cats.forEach(function(c) {
          var active = currentCategory === c.slug ? ' active' : '';
          html += '<a href="#" class="filter-link' + active + '" data-category="' + c.slug + '">' + escHtml(c.name) + '</a>';
        });
        container.innerHTML = html;
        container.querySelectorAll('.filter-link').forEach(function(link) {
          link.addEventListener('click', function(e) {
            e.preventDefault();
            var cat = link.getAttribute('data-category') || '';
            if (cat === currentCategory) return;
            currentCategory = cat;
            currentPage = 1;
            updateUrl();
            container.querySelectorAll('.filter-link').forEach(function(l) { l.classList.remove('active'); });
            link.classList.add('active');
            showGridLoading();
            loadProducts();
          });
        });
      } catch (e) {}
    }

    async function loadProducts() {
      var grid = document.getElementById('products-grid');
      var qs = new URLSearchParams();
      qs.set('page', String(currentPage));
      qs.set('page_size', '12');
      qs.set('zero_price', 'true');
      if (currentCategory) qs.set('category', currentCategory);
      if (currentSearch) qs.set('search', currentSearch);
      if (currentSort) qs.set('sort', currentSort);

      try {
        var res = await fetch(API_URL + '/api/products?' + qs);
        if (!res.ok) throw new Error('Failed');
        var data = await res.json();
        document.getElementById('product-count').textContent = '共 ' + data.total + ' 件商品';

        if (!data.items.length) {
          grid.innerHTML = '<div class="text-center text-secondary" style="grid-column:1/-1;padding:var(--sp-16)"><p>目前還沒有 0 元商品</p></div>';
          document.getElementById('pagination').innerHTML = '';
          hideGridLoading();
          return;
        }

        grid.innerHTML = data.items.map(function(p) {
          var displayPrice = p.sale_price !== null ? p.sale_price : p.price;
          var priceHtml = '<span style="font-weight:500;color:var(--c-primary)">' + _fmt(displayPrice) + '</span>';
          var imgHtml = p.image_url
            ? '<img src="' + p.image_url + '" alt="' + escHtml(p.name) + '" style="width:100%;height:100%;object-fit:cover" />'
            : '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%"><svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1" opacity="0.15"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>';
          return '<a href="/products/' + p.slug + '/" class="product-card">' +
            '<div class="product-image">' + imgHtml + '</div>' +
            '<div class="product-meta">' +
            (p.category_name ? '<span class="product-category">' + escHtml(p.category_name) + '</span>' : '') +
            '<h3 class="product-name">' + escHtml(p.name) + '</h3>' +
            '<div class="product-price">' + priceHtml + '</div>' +
            '</div></a>';
        }).join('');

        var paginationHtml = '';
        if (data.pages > 1) {
          paginationHtml += '<button class="btn btn-secondary btn-sm"' + (currentPage <= 1 ? ' disabled' : '') + ' onclick="goPage(' + (currentPage - 1) + ')">← 上一頁</button>';
          paginationHtml += '<span class="text-sm text-secondary">' + currentPage + ' / ' + data.pages + '</span>';
          paginationHtml += '<button class="btn btn-secondary btn-sm"' + (currentPage >= data.pages ? ' disabled' : '') + ' onclick="goPage(' + (currentPage + 1) + ')">下一頁 →</button>';
        }
        document.getElementById('pagination').innerHTML = paginationHtml;
        hideGridLoading();
      } catch (e) {
        grid.innerHTML = '<div class="text-center text-secondary" style="grid-column:1/-1;padding:var(--sp-16)">目前網路出現狀況中，請稍後再試</div>';
        hideGridLoading();
      }
    }

    window.goPage = function(page) {
      if (page < 1) return;
      currentPage = page;
      updateUrl();
      showGridLoading();
      loadProducts();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    document.querySelectorAll('#sort-filters .filter-link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var sort = link.dataset.sort;
        if (sort === currentSort) return;
        currentSort = sort;
        currentPage = 1;
        updateUrl();
        document.querySelectorAll('#sort-filters .filter-link').forEach(function(l) { l.classList.remove('active'); });
        link.classList.add('active');
        showGridLoading();
        loadProducts();
      });
    });

    var mobileSort = document.getElementById('mobile-sort');
    if (mobileSort) {
      mobileSort.value = currentSort;
      mobileSort.addEventListener('change', function() {
        var sort = this.value;
        if (sort === currentSort) return;
        currentSort = sort;
        currentPage = 1;
        updateUrl();
        document.querySelectorAll('#sort-filters .filter-link').forEach(function(l) {
          l.classList.toggle('active', l.dataset.sort === sort);
        });
        showGridLoading();
        loadProducts();
      });
    }

    loadCategories();
    loadProducts();
  });
</script>

<style>
  .page-header {
    padding: var(--sp-10) 0;
    border-bottom: 1px solid var(--c-border);
    margin-bottom: var(--sp-6);
  }
  .page-header h1 { font-size: var(--text-3xl); font-weight: 400; margin-bottom: var(--sp-2); }
  .intro-banner {
    background: var(--c-bg-alt);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: var(--sp-5) var(--sp-6);
    margin-bottom: var(--sp-8);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--c-text-secondary);
  }
  .intro-banner strong { color: var(--c-primary); font-weight: 600; }
  .products-layout { display: grid; grid-template-columns: 200px 1fr; gap: var(--sp-10); padding-bottom: var(--sp-16); }
  .sidebar { position: sticky; top: 80px; align-self: start; }
  .filter-group { margin-bottom: var(--sp-8); }
  .filter-title { font-size: var(--text-xs); font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-text-light); margin-bottom: var(--sp-3); }
  .filter-link { display: block; font-size: var(--text-sm); color: var(--c-text-secondary); padding: var(--sp-1) 0; transition: color var(--duration) var(--ease); }
  .filter-link:hover, .filter-link.active { color: var(--c-text); }
  .mobile-filters { margin-bottom: var(--sp-4); }
  .pagination { display: flex; align-items: center; justify-content: center; gap: var(--sp-4); margin-top: var(--sp-10); padding-top: var(--sp-8); border-top: 1px solid var(--c-border); }
  @media (max-width: 768px) { .products-layout { grid-template-columns: 1fr; gap: var(--sp-4); } }
</style>
