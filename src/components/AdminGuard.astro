<script is:inline>
  window.__requireAdmin = function() {
    var token = localStorage.getItem('shop_token');
    var userStr = localStorage.getItem('shop_user');
    var user = userStr ? JSON.parse(userStr) : null;

    if (!token || !user) {
      window.location.href = '/login';
      return false;
    }

    if (user.email !== 'hi@nasirlin.net') {
      document.body.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;min-height:100vh;font-family:sans-serif;text-align:center"><div><div style="font-size:72px;font-weight:300;color:#ddd;margin-bottom:16px">403</div><h1 style="font-size:20px;font-weight:400;margin-bottom:8px">Forbidden</h1><p style="color:#999;font-size:14px">你沒有權限訪問此頁面。</p><a href="/" style="display:inline-block;margin-top:24px;padding:8px 24px;background:#111;color:#fff;border-radius:6px;text-decoration:none;font-size:14px">回到首頁</a></div></div>';
      return false;
    }

    return true;
  };
</script>
