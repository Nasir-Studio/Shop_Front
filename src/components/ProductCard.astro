---
interface Props {
  name: string;
  slug: string;
  price: number;
  sale_price: number | null;
  image_url: string;
  category_name: string | null;
}

const { name, slug, price, sale_price, image_url, category_name } = Astro.props;
const displayPrice = sale_price ?? price;
const hasDiscount = sale_price !== null && sale_price < price;
---

<a href={`/products/${slug}`} class="product-card card">
  <div class="product-image">
    {image_url ? (
      <img src={image_url} alt={name} loading="lazy" />
    ) : (
      <div class="product-placeholder">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </div>
    )}
    {hasDiscount && <span class="product-sale-badge">SALE</span>}
    <span class="product-secondhand-badge">二手</span>
  </div>
  <div class="product-info">
    {category_name && <span class="product-category">{category_name}</span>}
    <h3 class="product-name">{name}</h3>
    <div class="product-pricing">
      <span class="product-price" data-ntd={displayPrice}>
        {displayPrice === 0 ? '免費' : `NT$${Math.round(displayPrice).toLocaleString()}`}
      </span>
      {hasDiscount && (
        <span class="product-original-price" data-ntd={price}>NT$${Math.round(price).toLocaleString()}</span>
      )}
    </div>
    <div class="product-secondhand-note">所有商品皆為二手，請確認狀況後索取</div>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .product-image {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: var(--c-bg-alt);
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }

  .product-card:hover .product-image img {
    transform: scale(1.03);
  }

  .product-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-bg-alt);
  }

  .product-sale-badge {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    padding: var(--sp-1) var(--sp-2);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    background: var(--c-bg-dark);
    color: var(--c-text-inverse);
  }

  .product-secondhand-badge {
    position: absolute;
    bottom: var(--sp-3);
    right: var(--sp-3);
    padding: 2px var(--sp-2);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.04em;
    background: #fefce8;
    color: #a16207;
    border: 1px solid #fde68a;
    border-radius: 2px;
  }

  .product-info {
    padding: var(--sp-4) var(--sp-2);
  }

  .product-category {
    font-size: var(--text-xs);
    color: var(--c-text-light);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .product-name {
    font-size: var(--text-sm);
    font-weight: 400;
    margin-top: var(--sp-1);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-pricing {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
  }

  .product-price {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .product-secondhand-note {
    font-size: 10px;
    color: var(--c-text-light);
    margin-top: var(--sp-2);
    line-height: 1.3;
  }

  .product-original-price {
    font-size: var(--text-xs);
    color: var(--c-text-light);
    text-decoration: line-through;
  }
</style>
