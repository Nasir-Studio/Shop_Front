---
export interface Props {
  /** 要預載的圖片 CSS 選擇器，例如 ".product-card img" */
  preloadSelector?: string;
  /** 額外要預載的圖片 URL */
  preloadUrls?: string[];
}
const { preloadSelector, preloadUrls } = Astro.props;
---

<div id="loading-screen" class="loading-screen" data-prel-sel={preloadSelector || ''} data-prel-urls={JSON.stringify(preloadUrls || [])}>
  <div class="loading-content">
    <div class="loading-icon">
      <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M12 3C8 3 4 6 4 10c0 2 1 4 3 5l-1 6h12l-1-6c2-1 3-3 3-5 0-4-4-7-8-7z"/>
        <circle cx="9" cy="10" r="1" fill="currentColor"/>
        <circle cx="15" cy="10" r="1" fill="currentColor"/>
      </svg>
    </div>
    <div class="loading-brand">小羊農場</div>
    <div class="loading-bar-track">
      <div class="loading-bar-fill" id="loading-bar-fill"></div>
    </div>
    <div class="loading-percentage" id="loading-percentage"></div>
  </div>
</div>

<script is:inline>
  (function() {
    var screen = document.getElementById('loading-screen');
    var bar = document.getElementById('loading-bar-fill');
    var pctEl = document.getElementById('loading-percentage');
    if (!screen || !bar || !pctEl) return;

    var running = true;
    var ready = false;    // 頁面完全載入時為 true
    var SIM_DURATION = 1400; // 模擬約 90% 所需毫秒數
    var FADE_DELAY = 300;

    // 全域 API：頁面可推入圖片 URL 進行背景預載
    var preloadUrls = [];
    window.__loadingPreload = function(urls) {
      urls.forEach(function(url) {
        if (url && preloadUrls.indexOf(url) === -1) preloadUrls.push(url);
      });
      preloadUrls.forEach(function(url) {
        var img = new Image();
        img.src = url;
      });
    };

    var sel = screen.getAttribute('data-prel-sel') || '';
    if (sel) {
      function scanAndPreload() {
        document.querySelectorAll(sel).forEach(function(img) {
          var src = img.getAttribute('src') || img.getAttribute('data-src') || '';
          if (src) { var i = new Image(); i.src = src; }
        });
      }
      if (document.readyState !== 'loading') {
        scanAndPreload();
      } else {
        document.addEventListener('DOMContentLoaded', scanAndPreload);
      }
    }

    (function() {
      var urls = screen.getAttribute('data-prel-urls') || '[]';
      try { var arr = JSON.parse(urls); arr.forEach(function(u) { if (u) { var i = new Image(); i.src = u; } }); } catch(e) {}
    })();

    function done() {
      if (!running) return;
      running = false;
      screen.classList.add('loading-complete');
      setTimeout(function() {
        screen.classList.add('loading-hidden');
      }, FADE_DELAY);
    }

    var startTime = Date.now();
    var completed = false;

    function animate() {
      if (!running) return;
      var elapsed = Date.now() - startTime;
      var t = Math.min(elapsed / SIM_DURATION, 1);

      var eased = 1 - Math.pow(1 - t, 3);
      // 映射到 1% → 92%，留空間給最後跳轉
      var pct = 1 + eased * 91;
      pct = Math.min(pct, 100);

      bar.style.width = Math.round(pct) + '%';
      pctEl.textContent = Math.round(pct) + '%';

      if (pct >= 100 && !completed) {
        completed = true;
        ready = true;
        done();
        return;
      }

      // 模擬接近完成（~92%）時，檢查能否直接跳 100
      if (pct >= 92 && !completed) {
        if (ready) {
          bar.style.width = '100%';
          pctEl.textContent = '100%';
          completed = true;
          done();
          return;
        }
        // 否則放慢補足剩餘 8%
        requestAnimationFrame(animate);
      } else {
        requestAnimationFrame(animate);
      }
    }

    window.addEventListener('load', function() { ready = true; });

    // 保險：4 秒強制完成
    setTimeout(function() { if (running) { ready = true; } }, 4000);

    requestAnimationFrame(animate);
  })();
</script>

<style>
  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-bg);
    transition: opacity 0.4s ease;
  }

  .loading-screen.loading-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .loading-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }

  .loading-icon {
    color: var(--c-text-light);
    margin-bottom: var(--sp-2);
    animation: loading-pulse 1.5s ease-in-out infinite;
  }

  @keyframes loading-pulse {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  .loading-brand {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--c-text-secondary);
    margin-bottom: var(--sp-3);
  }

  .loading-bar-track {
    width: 200px;
    height: 2px;
    background: var(--c-border);
    border-radius: 2px;
    overflow: hidden;
  }

  .loading-bar-fill {
    height: 100%;
    width: 0%;
    background: var(--c-bg-dark);
    border-radius: 2px;
    transition: width 0.1s linear;
  }

  .loading-percentage {
    font-size: var(--text-xs);
    color: var(--c-text-light);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    min-width: 32px;
    text-align: center;
  }

  .loading-screen.loading-complete .loading-icon {
    animation: loading-done 0.4s ease forwards;
  }

  @keyframes loading-done {
    0% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(0.8); }
  }

  @media (max-width: 768px) {
    .loading-bar-track { width: 160px; }
  }
</style>
