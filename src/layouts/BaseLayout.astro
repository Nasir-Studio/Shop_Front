---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = '小羊農場 — 物品價值，淋漓盡致',
  description = '小羊農場，讓每件物品的價值淋漓盡致。',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://shop.nsir.uk" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1a1a1a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  <meta name="apple-mobile-web-app-title" content="小羊農場" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <link rel="preconnect" href="https://shopbackend.nsir.uk" />
  <link rel="dns-prefetch" href="https://shopbackend.nsir.uk" />
  <link rel="preconnect" href="https://open.er-api.com" />

  <!-- Sync auth state — runs before first paint, eliminates flicker -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('shop_token');
      if (t) {
        document.documentElement.classList.add('auth-logged-in');
        try {
          var u = JSON.parse(localStorage.getItem('shop_user') || '{}');
          if (u.role === 'admin') document.documentElement.classList.add('auth-admin');
        } catch(e) {}
      }
      // When admin opens the PWA (standalone/added to Home Screen), land on
      // the admin backend instead of the storefront. Only apply in standalone
      // mode and only once per launch so /admin pages don't loop.
      if (!sessionStorage.getItem('pwa_admin_redirected')) {
        if (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) {
          var u2 = null;
          try { u2 = JSON.parse(localStorage.getItem('shop_user') || 'null'); } catch(e) {}
          var path = window.location.pathname;
          if (u2 && u2.role === 'admin' && path !== '/admin' && !path.startsWith('/admin')) {
            sessionStorage.setItem('pwa_admin_redirected', '1');
            window.location.replace('/admin');
          }
        }
      }
      // Pre-load cart count for badge visibility
      var c = parseInt(localStorage.getItem('shop_cart_count') || '0', 10);
      if (c > 0) { document.documentElement.classList.add('has-cart'); }

      // Announcement banner — show if never closed or 7 days have passed
      var closeTs = localStorage.getItem('announcement_closed');
      var WEEK = 7 * 24 * 60 * 60 * 1000;
      if (!closeTs || (Date.now() - parseInt(closeTs) > WEEK)) {
        document.documentElement.classList.add('announcement-visible');
      }
    })();
  </script>

  <!-- Critical visibility — applied before body renders, no flicker -->
  <style>
    #user-dropdown { display: none; }
    #mobile-account-link { display: none; }
    #announcement-banner { display: none; }
    .auth-logged-in #login-btn { display: none !important; }
    .auth-logged-in #user-dropdown { display: block !important; }
    .auth-logged-in #mobile-login-link { display: none !important; }
    .auth-logged-in #mobile-account-link { display: block !important; }
    .auth-logged-in #mobile-orders-link { display: block !important; }
    .auth-logged-in #mobile-logout-btn { display: block !important; }
    .auth-admin #admin-link { display: block !important; }
    .has-cart #cart-badge { display: flex !important; }
    .announcement-visible #announcement-banner { display: block; }
  </style>

  <!-- ── Currency support ── -->
  <script is:inline>
    (function() {
      window.__currency = {};

      var STORAGE_KEY = 'shop_currency_code';
      var RATES_KEY = 'shop_exchange_rates';
      var RATES_TTL = 3600000; // 1 hour

      var CURRENCIES = {
        TWD: { symbol: 'NT$', label: '台幣', decimals: 0 },
        USD: { symbol: '$',    label: '美元', decimals: 2 },
        EUR: { symbol: '€',    label: '歐元', decimals: 2 },
        JPY: { symbol: '¥',    label: '日圓', decimals: 0 },
        CNY: { symbol: '¥',    label: '人民幣', decimals: 2 },
        HKD: { symbol: 'HK$',  label: '港幣', decimals: 2 },
        SGD: { symbol: 'S$',   label: '新加坡幣', decimals: 2 },
        KRW: { symbol: '₩',    label: '韓圓', decimals: 0 },
        GBP: { symbol: '£',    label: '英鎊', decimals: 2 },
        AUD: { symbol: 'A$',   label: '澳幣', decimals: 2 },
      };

      var cc = window.__currency;
      cc.currencies = CURRENCIES;
      cc._code = localStorage.getItem(STORAGE_KEY) || 'TWD';
      cc._rates = null;
      cc._rateCallbacks = [];

      cc.getCode = function() { return cc._code; };
      cc.getInfo = function(code) { return CURRENCIES[code] || CURRENCIES.TWD; };
      cc.getSymbol = function(code) { return cc.getInfo(code || cc._code).symbol; };
      cc.getDecimals = function(code) { return cc.getInfo(code || cc._code).decimals; };

      cc.convert = function(ntd, toCode) {
        if (!toCode) toCode = cc._code;
        if (toCode === 'TWD') return ntd;
        var rate = cc._rates && cc._rates[toCode];
        return rate ? ntd * rate : ntd;
      };

      cc.format = function(ntd, toCode) {
        var code = toCode || cc._code;
        var info = cc.getInfo(code);
        var converted = cc.convert(ntd, code);
        var formatted = converted.toLocaleString(undefined, {
          minimumFractionDigits: info.decimals,
          maximumFractionDigits: info.decimals,
        });
        var sym = info.symbol;
        if (code === 'JPY' || code === 'CNY' || code === 'KRW') return sym + formatted;
        return sym + ' ' + formatted;
      };

      cc.setCurrency = function(code) {
        if (!CURRENCIES[code]) return;
        cc._code = code;
        try { localStorage.setItem(STORAGE_KEY, code); } catch(e) {}
        document.documentElement.setAttribute('data-currency', code);
        // Re-convert visible prices
        cc.applyPrices();
      };

      cc.applyPrices = function() {
        document.querySelectorAll('[data-ntd]').forEach(function(el) {
          var ntd = parseFloat(el.getAttribute('data-ntd'));
          if (!isNaN(ntd)) {
            var text = cc.format(ntd);
            if (el.tagName === 'INPUT') {
              el.value = text;
            } else {
              el.textContent = text;
            }
          }
        });
      };

      cc._loadRates = function(callback) {
        cc._rateCallbacks.push(callback || function(){});
        if (cc._loading) return;
        cc._loading = true;

        var cached = null;
        try {
          var raw = localStorage.getItem(RATES_KEY);
          if (raw) {
            var parsed = JSON.parse(raw);
            if (parsed.ts && Date.now() - parsed.ts < RATES_TTL) {
              cached = parsed.rates;
            }
          }
        } catch(e) {}

        if (cached) {
          cc._rates = cached;
          cc._loading = false;
          var cbs = cc._rateCallbacks;
          cc._rateCallbacks = [];
          cbs.forEach(function(fn) { try { fn(); } catch(e) {} });
          return;
        }

        var script = document.createElement('script');
        script.src = 'https://open.er-api.com/v6/latest/TWD?callback=__currency_cb';
        var timeout = setTimeout(function() {
          // Fallback: use hardcoded approximate rates
          cc._rates = { USD: 0.031, EUR: 0.028, JPY: 4.75, CNY: 0.22, HKD: 0.24, SGD: 0.041, KRW: 40.5, GBP: 0.024, AUD: 0.046 };
          cc._loading = false;
          var cbs = cc._rateCallbacks;
          cc._rateCallbacks = [];
          cbs.forEach(function(fn) { try { fn(); } catch(e) {} });
        }, 5000);

        window.__currency_cb = function(data) {
          clearTimeout(timeout);
          if (data && data.rates) {
            cc._rates = data.rates;
            try {
              localStorage.setItem(RATES_KEY, JSON.stringify({ rates: data.rates, ts: Date.now() }));
            } catch(e) {}
          } else {
            cc._rates = { USD: 0.031, EUR: 0.028, JPY: 4.75, CNY: 0.22, HKD: 0.24, SGD: 0.041, KRW: 40.5, GBP: 0.024, AUD: 0.046 };
          }
          cc._loading = false;
          var cbs = cc._rateCallbacks;
          cc._rateCallbacks = [];
          cbs.forEach(function(fn) { try { fn(); } catch(e) {} });
          delete window.__currency_cb;
        };
        document.head.appendChild(script);
      };

      cc.ready = function(callback) {
        if (cc._rates) {
          setTimeout(callback, 0);
          return;
        }
        cc._loadRates(callback);
      };

      // Init: restore currency attribute and attempt rate load
      document.documentElement.setAttribute('data-currency', cc._code);
      cc._loadRates();

      // After DOM ready, apply prices to [data-ntd] elements
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { cc.ready(cc.applyPrices); });
      } else {
        cc.ready(cc.applyPrices);
      }
    })();
  </script>

  <script is:inline>
    // ── Anti-debug: prevent console, debugger, and devtools ──
    (function() {
      // Domain binding — only allow our domains
      var allowed = ['shop.nsir.uk', 'localhost', '127.0.0.1', 'nsir-studio.github.io'];
      var host = window.location.hostname;
      var ok = allowed.some(function(d) { return host === d || host.endsWith('.' + d); });
      if (!ok) {
        document.open();
        document.write('<!DOCTYPE html><html><head><title>Access Denied</title></head><body style="background:#111;color:#fff;font-family:sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0"><h1>Access Denied</h1></body></html>');
        document.close();
        window.stop();
        return;
      }

      // Anti-debug: override console if in production
      if (host === 'shop.nsir.uk') {
        var noop = function() {};
        ['log','warn','info','debug','dir','table','trace','group','groupCollapsed','groupEnd','time','timeEnd','profile','profileEnd'].forEach(function(m) {
          if (window.console) window.console[m] = noop;
        });
        // Block debugger statements via periodic override
        var blockDebugger = function() {
          var start = Date.now();
          debugger; // If devtools is open, this pauses — the code below won't run in time
          var diff = Date.now() - start;
          if (diff > 5) {
            document.body.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;min-height:100vh;font-family:sans-serif;background:#111;color:#fff;margin:0"><p>DevTools 已禁用</p></div>';
            window.stop();
          }
        };
        // Attempt to detect devtools on load
        try {
          Object.defineProperty(document, 'domain', { get: function() { return 'shop.nsir.uk'; } });
        } catch(e) {}
        // Freeze some globals to prevent tampering
        if (Object.freeze) {
          try { Object.freeze(window.console); } catch(e) {}
        }
        // Periodic anti-debug check (runs once)
        setTimeout(blockDebugger, 1000);
      }
    })();
  </script>

  <!-- ── API Cache: stale-while-revalidate ── -->
  <script is:inline>
    (function() {
      var CACHE_PREFIX = 'shop_cache_';
      var CACHE_TTL = 10000; // 10s fresh, then refetch and wait
      window.__apiCache = {
        get: function(key) {
          try {
            var raw = localStorage.getItem(CACHE_PREFIX + key);
            if (!raw) return null;
            var entry = JSON.parse(raw);
            entry.stale = Date.now() - entry.ts > CACHE_TTL;
            return entry;
          } catch(e) { return null; }
        },
        set: function(key, data) {
          try {
            localStorage.setItem(CACHE_PREFIX + key, JSON.stringify({ data: data, ts: Date.now() }));
          } catch(e) {}
        },
        // Fetch with stale-while-revalidate: return cached instantly, refresh in background
        fetch: async function(url, key, options) {
          var cached = window.__apiCache.get(key || url);
          if (cached && !cached.stale) return cached.data; // fresh
          if (cached) {
            // stale: refetch and wait so the current page shows fresh data;
            // fall back to stale only when the network is unavailable
            try {
              var res = await fetch(url, options || {});
              if (!res.ok) throw new Error();
              var fresh = await res.json();
              window.__apiCache.set(key || url, fresh);
              return fresh;
            } catch (e) {
              return cached.data;
            }
          }
          // no cache: fetch and wait
          var res = await fetch(url, options || {});
          if (!res.ok) throw new Error('API error');
          var data = await res.json();
          window.__apiCache.set(key || url, data);
          return data;
        }
      };
    })();
  </script>
</head>
<body>
  <slot />
  <script is:inline>
    // Sync token and user state on load
    (function() {
      const token = localStorage.getItem('shop_token');
      const user = localStorage.getItem('shop_user');
      if (!token && user) localStorage.removeItem('shop_user');
      // Dispatch event for components to react
      window.dispatchEvent(new Event('shop:loaded'));
    })();

    // ── Web Push (PWA notifications) ──
    // iOS 16.4+: subscribe() MUST run inside a user gesture, and the site
    // must be added to Home Screen (standalone). So we expose window.__push
    // and let the admin bell trigger subscribe on click.
    var API_ORIGIN = window.location.hostname === 'shop.nsir.uk' ? 'https://shopbackend.nsir.uk' : 'http://localhost:8000';
    window.__push = null;

    function urlBase64ToUint8Array(base64String) {
      var padding = '='.repeat((4 - base64String.length % 4) % 4);
      var base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
      var raw = atob(base64);
      var arr = new Uint8Array(raw.length);
      for (var i = 0; i < raw.length; i++) arr[i] = raw.charCodeAt(i);
      return arr;
    }

    function isStandalone() {
      return window.matchMedia && window.matchMedia('(display-mode: standalone)').matches
        || window.navigator.standalone === true;
    }

    window.__push = {
      supported: function() {
        return 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
      },
      isIOS: function() {
        return /iphone|ipad|ipod/i.test(navigator.userAgent);
      },
      isStandalone: isStandalone,
      // iOS needs the app added to Home Screen before subscribing
      needsInstall: function() {
        return this.isIOS() && !isStandalone();
      },
      permission: function() {
        if (!('Notification' in window)) return 'unsupported';
        return Notification.permission;
      },
      getSubscription: function() {
        if (!('serviceWorker' in navigator)) return Promise.resolve(null);
        return navigator.serviceWorker.ready
          .then(function(reg) { return reg.pushManager.getSubscription(); })
          .catch(function() { return null; });
      },
      // Subscribe — MUST be called from a user gesture (click)
      subscribe: function() {
        var token = localStorage.getItem('shop_token');
        if (!token) return Promise.reject(new Error('未登入'));
        if (!('serviceWorker' in navigator)) return Promise.reject(new Error('瀏覽器不支援推播'));
        return navigator.serviceWorker.register('/sw.js')
          .then(function() { return navigator.serviceWorker.ready; })
          .then(function(reg) {
            if (Notification.permission === 'denied') {
              throw new Error('通知權限已被封鎖，請在瀏覽器設定中開啟');
            }
            return fetch(API_ORIGIN + '/api/push/public-key')
              .then(function(r) { return r.json(); })
              .then(function(data) {
                if (!data.public_key) throw new Error('推播服務未設定');
                return reg.pushManager.subscribe({
                  userVisibleOnly: true,
                  applicationServerKey: urlBase64ToUint8Array(data.public_key)
                });
              });
          })
          .then(function(sub) {
            return fetch(API_ORIGIN + '/api/push/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
              body: JSON.stringify({
                endpoint: sub.endpoint,
                keys: {
                  p256dh: btoa(String.fromCharCode.apply(null, new Uint8Array(sub.getKey('p256dh')))),
                  auth: btoa(String.fromCharCode.apply(null, new Uint8Array(sub.getKey('auth'))))
                }
              })
            }).then(function(r) { if (!r.ok) throw new Error('訂閱失敗'); return true; });
          });
      },
      unsubscribe: function() {
        var token = localStorage.getItem('shop_token');
        return this.getSubscription().then(function(sub) {
          var endpoint = sub ? sub.endpoint : '';
          if (sub) {
            return sub.unsubscribe().catch(function() {}).then(function() {
              if (token && endpoint && fetch) {
                return fetch(API_ORIGIN + '/api/push/subscribe?endpoint=' + encodeURIComponent(endpoint), {
                  method: 'DELETE',
                  headers: { 'Authorization': 'Bearer ' + token }
                }).catch(function() {});
              }
            });
          }
          return null;
        });
      }
    };

    // Register service worker (for PWA + push)
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').catch(function(err) {
          console.warn('SW registration failed:', err);
        });
      });
    }
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
